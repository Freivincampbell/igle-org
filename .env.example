# Igle Org environment template.
# Copy this file to .env for local development.
# Keep real secrets out of Git. Sensitive values are intentionally commented.

# Rails runtime
RAILS_ENV=development
RACK_ENV=development
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=debug
WEB_CONCURRENCY=0
JOB_CONCURRENCY=1
# Set to 1 only when the web process should also run Solid Queue.
# SOLID_QUEUE_IN_PUMA=1
PORT=3000
PIDFILE=tmp/pids/server.pid

# Application URL
APP_NAME=igle-org
APP_HOST=localhost
APP_PORT=3000
APP_PROTOCOL=http
APP_URL=http://localhost:3000
DEFAULT_LOCALE=es
TIME_ZONE=America/Costa_Rica

# PostgreSQL
# Docker development uses POSTGRES_HOST_AUTH_METHOD=trust inside compose.yml,
# so no password is required for the bundled db container.
DATABASE_HOST=db
DATABASE_PORT=5432
POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# DATABASE_URL=
# IGLE_ORG_DATABASE_PASSWORD=

# Devise
DEVISE_MAILER_SENDER=no-reply@igle-org.local

# Action Mailer / SMTP
# These are future-ready defaults. They are not required until real email is enabled.
ACTION_MAILER_DELIVERY_METHOD=smtp
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_DOMAIN=localhost
SMTP_USER_NAME=
# SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=false

# Active Storage
ACTIVE_STORAGE_SERVICE=local

# DigitalOcean Spaces or S3-compatible storage
# These are future-ready and not required while ACTIVE_STORAGE_SERVICE=local.
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=

# Initial platform bootstrap
# These will be useful once seed/setup tasks exist.
SEED_SUPER_ADMIN_EMAIL=admin@igle-org.local
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin
# SEED_SUPER_ADMIN_PASSWORD=

# Billing / future payments
BILLING_ENABLED=false
BILLING_PROVIDER=
STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# Deployment / Kamal / production secrets
DOCKER_REGISTRY_SERVER=
DOCKER_REGISTRY_USERNAME=
# KAMAL_REGISTRY_PASSWORD=
# RAILS_MASTER_KEY=
