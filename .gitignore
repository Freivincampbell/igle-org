# OS and editor files
.DS_Store
.AppleDouble
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Ruby and local tooling
*.rbc
.byebug_history
.pry_history
.ruby-lsp/
.rubocop-cache/
.yardoc/
.rvmrc
/.bundle
/.mise.local.toml
/vendor/bundle

# Environment variables and secrets
.env*
!.env.example
/config/master.key
/config/*.key
/config/credentials/*.key
*.pem
*.p12
*.pfx

# Rails logs and temp files
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep
!/tmp/storage/
/tmp/storage/*
!/tmp/storage/.keep

# Test and coverage output
/coverage/
/spec/tmp
capybara-*.html
rerun.txt
pickle-email-*.html

# Local databases, dumps, and generated database files
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-[0-9]*
*.dump
*.sql.gz
*.tar.gz

# Uploaded files and generated public files
/storage/*
!/storage/.keep
/public/system
/public/uploads
/public/assets
/public/packs
/public/packs-test

# Generated assets and package-manager output
/app/assets/builds/*
!/app/assets/builds/.keep
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log
.yarn-integrity

# Docker and local deployment overrides
compose.override.yml
docker-compose.override.yml
config/deploy*.local.yml
.kamal/*.local

# Legacy/generated files
*.orig
*.bowerrc
bower.json
/vendor/assets/bower_components
.powenv
