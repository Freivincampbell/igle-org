<%# locals: (pagy:) %>
<% return unless pagy.last > 1 %>
<%
  current = pagy.options[:page].to_i
  total   = pagy.last

  # Build compact page series (up to 7 slots) using only public API
  half         = 3
  window_start = [1, current - half].max
  window_end   = [total, window_start + 6].min
  window_start = [1, window_end - 6].max
%>
<div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 px-5 py-3">
  <p class="text-xs text-slate-500">
    Mostrando <span class="font-medium text-slate-700"><%= pagy.from %>–<%= pagy.to %></span>
    de <span class="font-medium text-slate-700"><%= pagy.count %></span> registros
  </p>

  <nav class="flex items-center gap-1">

    <%# ← Anterior %>
    <% if pagy.previous %>
      <%= link_to url_for(params.permit!.merge(page: pagy.previous)),
            class: "flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-violet-50 hover:text-violet-700 hover:border-violet-200 transition-colors" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
      <% end %>
    <% else %>
      <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-100 text-slate-300 cursor-not-allowed">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
      </span>
    <% end %>

    <%# Primera página + gap si la ventana no empieza en 1 %>
    <% if window_start > 1 %>
      <%= link_to 1, url_for(params.permit!.merge(page: 1)),
            class: "flex h-8 min-w-8 items-center justify-center rounded-lg border border-slate-200 bg-white px-2 text-sm font-medium text-slate-600 hover:bg-violet-50 hover:text-violet-700 hover:border-violet-200 transition-colors" %>
      <% if window_start > 2 %>
        <span class="flex h-8 w-6 items-center justify-center text-xs text-slate-400">…</span>
      <% end %>
    <% end %>

    <%# Ventana de páginas %>
    <% (window_start..window_end).each do |p| %>
      <% if p == current %>
        <span class="flex h-8 min-w-8 items-center justify-center rounded-lg border border-violet-500 bg-violet-600 px-2 text-sm font-semibold text-white"><%= p %></span>
      <% else %>
        <%= link_to p, url_for(params.permit!.merge(page: p)),
              class: "flex h-8 min-w-8 items-center justify-center rounded-lg border border-slate-200 bg-white px-2 text-sm font-medium text-slate-600 hover:bg-violet-50 hover:text-violet-700 hover:border-violet-200 transition-colors" %>
      <% end %>
    <% end %>

    <%# Gap + última página si la ventana no termina en total %>
    <% if window_end < total %>
      <% if window_end < total - 1 %>
        <span class="flex h-8 w-6 items-center justify-center text-xs text-slate-400">…</span>
      <% end %>
      <%= link_to total, url_for(params.permit!.merge(page: total)),
            class: "flex h-8 min-w-8 items-center justify-center rounded-lg border border-slate-200 bg-white px-2 text-sm font-medium text-slate-600 hover:bg-violet-50 hover:text-violet-700 hover:border-violet-200 transition-colors" %>
    <% end %>

    <%# Siguiente → %>
    <% if pagy.next %>
      <%= link_to url_for(params.permit!.merge(page: pagy.next)),
            class: "flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-violet-50 hover:text-violet-700 hover:border-violet-200 transition-colors" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
      <% end %>
    <% else %>
      <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-100 text-slate-300 cursor-not-allowed">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
      </span>
    <% end %>

  </nav>
</div>
