<% if user_signed_in? %>
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200">

  <%# ── Top bar ── %>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 h-14">

    <%# Logo + breadcrumb %>
    <div class="flex items-center gap-4">
      <%= link_to root_path, class: "flex items-center gap-2.5 group shrink-0" do %>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-600 text-white font-bold text-sm shadow-sm group-hover:bg-violet-700 transition-colors">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12 11.204 3.045c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <span class="hidden sm:block text-sm font-bold tracking-tight text-slate-900">igle<span class="text-violet-600">·org</span></span>
      <% end %>

      <nav class="hidden md:flex items-center gap-1 text-sm">
        <% if current_user.super_admin? %>
          <%= link_to platform_root_path,
                class: "flex items-center gap-1.5 rounded-md px-3 py-1.5 font-medium transition-colors #{current_page?(platform_root_path) ? 'bg-violet-50 text-violet-700' : 'text-slate-500 hover:bg-slate-100 hover:text-slate-800'}" do %>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            Plataforma
          <% end %>
        <% end %>
        <%= link_to churches_path,
              class: "flex items-center gap-1.5 rounded-md px-3 py-1.5 font-medium transition-colors #{current_page?(churches_path) ? 'bg-violet-50 text-violet-700' : 'text-slate-500 hover:bg-slate-100 hover:text-slate-800'}" do %>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
          </svg>
          Mis iglesias
        <% end %>
        <% if current_church.present? && current_church_membership&.active? %>
          <svg class="h-4 w-4 text-slate-300 hidden md:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
          <span class="hidden md:flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-semibold text-violet-700 bg-violet-50">
            <%= current_church.name %>
          </span>
        <% end %>
      </nav>
    </div>

    <%# User area %>
    <div class="flex items-center gap-2">
      <div class="hidden sm:flex items-center gap-2">
        <div class="flex h-7 w-7 items-center justify-center rounded-full bg-violet-100 text-xs font-semibold text-violet-700">
          <%= current_user.email.first.upcase %>
        </div>
        <span class="hidden lg:block text-xs text-slate-500 max-w-[180px] truncate"><%= current_user.email %></span>
      </div>
      <%= button_to destroy_user_session_path, method: :delete,
            form_class: "inline-flex",
            class: "flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors cursor-pointer" do %>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
        </svg>
        <span class="hidden sm:block">Salir</span>
      <% end %>
    </div>
  </div>

  <%# ── Church sub-nav ── %>
  <% if current_church.present? && current_church_membership&.active? %>
  <div class="border-t border-slate-100">
    <nav class="mx-auto flex w-full max-w-7xl items-center gap-0.5 overflow-x-auto scrollbar-hide px-6 py-2">
      <%
        def nav_link(label, path, active, opts = {})
          base = "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors"
          active_cls = "bg-violet-50 text-violet-700"
          idle_cls   = "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
          link_to label, path, class: "#{base} #{active ? active_cls : idle_cls}"
        end
      %>

      <%= link_to church_path(current_church),
            class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{current_page?(church_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" do %>Resumen<% end %>

      <% if policy(Member).index? %>
        <%= link_to "Miembros", church_admin_members_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_members_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(Family).index? %>
        <%= link_to "Familias", church_admin_families_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_families_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(Ministry).index? %>
        <%= link_to "Ministerios", church_admin_ministries_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_ministries_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(Board).index? %>
        <%= link_to "Junta directiva", church_admin_boards_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_boards_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(Event).index? %>
        <%= link_to "Eventos", church_admin_events_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_events_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(ChurchServiceTime).index? %>
        <%= link_to "Horarios", church_admin_service_times_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_service_times_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if ServiceDirectoryPolicy.new(current_user, nil).index? %>
        <%= link_to "Directorio", church_admin_service_directory_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{current_page?(church_admin_service_directory_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(ProfileChangeRequest).index? %>
        <%= link_to "Solicitudes", church_admin_profile_change_requests_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_profile_change_requests_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if ReportPolicy.new(current_user, nil).index? %>
        <%= link_to "Reportes", church_admin_reports_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_reports_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(PastoralNote).index? %>
        <%= link_to "Notas pastorales", church_pastor_pastoral_notes_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_pastor_pastoral_notes_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>

      <%# Separator %>
      <span class="mx-1 text-slate-200 select-none">|</span>

      <% if policy(Role).index? %>
        <%= link_to "Roles", church_admin_roles_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_roles_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(ChurchMembership).index? %>
        <%= link_to "Usuarios", church_admin_memberships_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_memberships_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(Occupation).index? %>
        <%= link_to "Ocupaciones", church_admin_occupations_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_occupations_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>
      <% if policy(Skill).index? %>
        <%= link_to "Habilidades", church_admin_skills_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{request.path.start_with?(church_admin_skills_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
      <% end %>

      <%# Right-aligned items %>
      <div class="ml-auto flex items-center gap-0.5 shrink-0">
        <%= link_to "Mi perfil", church_member_portal_profile_path(current_church),
              class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors #{current_page?(church_member_portal_profile_path(current_church)) ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}" %>
        <% if church_setting_visible?(current_church) %>
          <%= link_to church_admin_settings_path(current_church),
                class: "flex items-center rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors #{current_page?(church_admin_settings_path(current_church)) ? 'bg-violet-50 text-violet-700' : ''}" do %>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
          <% end %>
        <% end %>
      </div>
    </nav>
  </div>
  <% end %>

</header>
<% end %>
