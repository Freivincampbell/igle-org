<section class="mx-auto w-full max-w-7xl px-6 py-10">
  <div class="border-b border-slate-200 pb-6">
    <%= link_to "← Volver a iglesias", platform_churches_path, class: "text-sm font-medium text-slate-600 hover:text-slate-950" %>

    <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Plataforma · Iglesia</p>
        <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @church.name %></h1>
        <p class="mt-1 font-mono text-xs text-slate-400"><%= @church.public_id %></p>
      </div>

      <div class="flex flex-wrap gap-2">
        <%= link_to "Editar", edit_platform_church_path(@church), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
        <%= link_to "Asignar admin", new_platform_church_church_membership_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
        <% if @church.active? %>
          <%= button_to "Desactivar", deactivate_platform_church_path(@church), method: :patch, class: "rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100 transition-colors cursor-pointer" %>
        <% else %>
          <%= button_to "Activar", activate_platform_church_path(@church), method: :patch, class: "rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100 transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_20rem]">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Datos de iglesia</h2>
      <dl class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Email</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @church.email.presence || "No definido" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Telefono</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @church.phone.presence || "No definido" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Sitio web</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @church.website.presence || "No definido" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</dt>
          <dd class="mt-2">
            <% if @church.active? %>
              <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><%= @church.status %></span>
            <% else %>
              <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-slate-200"><%= @church.status %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Locale</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @church.locale %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Zona horaria</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @church.time_zone %></dd>
        </div>
      </dl>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Administradores owner</h2>
      <div class="mt-4 space-y-3">
        <% @owner_memberships.each do |membership| %>
          <div class="rounded-lg border border-slate-200 p-3">
            <div class="flex items-center gap-3">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-violet-100 text-xs font-semibold text-violet-700">
                <%= membership.user.email.first.upcase %>
              </div>
              <div>
                <p class="text-sm font-medium text-slate-900"><%= membership.user.email %></p>
                <% if membership.active? %>
                  <span class="inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><%= membership.status %></span>
                <% else %>
                  <span class="inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-slate-200"><%= membership.status %></span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% if @owner_memberships.empty? %>
          <p class="text-sm text-slate-500">Esta iglesia todavia no tiene administrador owner.</p>
        <% end %>
      </div>
    </section>
  </div>
</section>
