<section class="mx-auto w-full max-w-7xl px-6 py-10">
  <div class="flex flex-col gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Plataforma</p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Iglesias</h1>
    </div>

    <%= link_to "Nueva iglesia", new_platform_church_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <table class="min-w-full divide-y divide-slate-200">
      <thead>
        <tr>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Nombre</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Contacto</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</th>
          <th class="bg-slate-50 px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @churches.each do |church| %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-5 py-4">
              <%= link_to church.name, platform_church_path(church), class: "font-semibold text-slate-900 hover:text-violet-700 transition-colors" %>
              <p class="mt-0.5 font-mono text-xs text-slate-400"><%= church.public_id %></p>
            </td>
            <td class="px-5 py-4 text-sm text-slate-600">
              <%= church.email.presence || "Sin email" %>
            </td>
            <td class="px-5 py-4">
              <% if church.active? %>
                <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><%= church.status %></span>
              <% else %>
                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-slate-200"><%= church.status %></span>
              <% end %>
            </td>
            <td class="px-5 py-4 text-right">
              <%= link_to "Ver", platform_church_path(church), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
            </td>
          </tr>
        <% end %>

        <% if @churches.empty? %>
          <tr>
            <td colspan="4" class="px-5 py-10 text-center text-sm text-slate-500">No hay iglesias registradas.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
