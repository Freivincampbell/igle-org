<section class="mx-auto w-full max-w-4xl px-6 py-8">
  <%= link_to "← Volver a iglesia", platform_church_path(@church), class: "text-sm font-medium text-slate-600 hover:text-slate-950" %>

  <div class="mt-5">
    <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Plataforma · <%= @church.name %></p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900">Asignar administrador owner</h1>
  </div>

  <%= form_with model: @owner_assignment, url: platform_church_church_memberships_path(@church), class: "mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-card" do |form| %>
    <% if @owner_assignment.errors.any? %>
      <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        <p class="font-medium">No se pudo asignar el administrador.</p>
        <ul class="mt-2 list-disc pl-5">
          <% @owner_assignment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :email, "Email", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :first_name, "Nombre", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :first_name, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :last_name, "Apellido", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :last_name, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :password, t("platform.owner_assignments.initial_access_label"), class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :password_confirmation, t("platform.owner_assignments.confirmation_label"), class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password_confirmation, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>
    </div>

    <div class="mt-6 flex justify-end gap-3">
      <%= link_to "Cancelar", platform_church_path(@church), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <%= form.submit "Asignar owner", class: "rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</section>
