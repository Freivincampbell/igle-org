<section class="mx-auto w-full max-w-3xl px-6 py-10">
  <%= link_to "Volver a iglesia", platform_church_path(@church), class: "text-sm font-medium text-slate-600 hover:text-slate-950" %>
  <h1 class="mt-5 text-3xl font-semibold text-slate-950">Asignar administrador owner</h1>
  <p class="mt-2 text-sm text-slate-600"><%= @church.name %></p>

  <%= form_with model: @owner_assignment, url: platform_church_church_memberships_path(@church), class: "mt-8 rounded-lg border border-slate-200 bg-white p-6" do |form| %>
    <% if @owner_assignment.errors.any? %>
      <div class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <p class="font-medium">No se pudo asignar el administrador.</p>
        <ul class="mt-2 list-disc pl-5">
          <% @owner_assignment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :email, "Email", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :first_name, "Nombre", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :first_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :last_name, "Apellido", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :last_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :password, t("platform.owner_assignments.initial_access_label"), class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :password_confirmation, t("platform.owner_assignments.confirmation_label"), class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password_confirmation, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>
    </div>

    <div class="mt-6 flex justify-end gap-3">
      <%= link_to "Cancelar", platform_church_path(@church), class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <%= form.submit "Asignar owner", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
    </div>
  <% end %>
</section>
