<%# Landing page — igle·org %>

<%# ── Hero ── %>
<section class="relative overflow-hidden bg-white">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(124,58,237,0.08),transparent)]"></div>
  <div class="mx-auto w-full max-w-6xl px-6 py-24 text-center sm:py-32">
    <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-xs font-semibold text-violet-700 mb-6">
      <span class="flex h-1.5 w-1.5 rounded-full bg-violet-500"></span>
      Plataforma multi-iglesia
    </div>
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
      Todo lo que tu iglesia<br class="hidden sm:block">
      <span class="text-violet-600">necesita para crecer</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
      Gestiona miembros, ministerios, eventos y permisos desde un panel unificado. Simple, seguro y diseñado para comunidades de fe.
    </p>
    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <% if user_signed_in? %>
        <%= link_to "Ir a mis iglesias", churches_path,
              class: "inline-flex items-center gap-2 rounded-lg bg-violet-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
      <% else %>
        <%= link_to "Comenzar ahora", new_user_session_path,
              class: "inline-flex items-center gap-2 rounded-lg bg-violet-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
      <% end %>
      <a href="#caracteristicas"
         class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        Ver características
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </a>
    </div>
  </div>
</section>

<%# ── Stats bar ── %>
<section class="border-y border-slate-100 bg-slate-50">
  <div class="mx-auto w-full max-w-5xl px-6 py-8">
    <dl class="grid grid-cols-2 gap-y-8 sm:grid-cols-4">
      <% [
        ["Módulos disponibles", "10+"],
        ["Aislamiento multi-tenant", "100%"],
        ["Roles y permisos", "Dinámicos"],
        ["Auditoría integrada", "Completa"],
      ].each do |label, value| %>
        <div class="text-center">
          <dt class="text-2xl font-bold text-violet-600"><%= value %></dt>
          <dd class="mt-1 text-xs font-medium text-slate-500"><%= label %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>

<%# ── Features ── %>
<section id="caracteristicas" class="bg-white py-20">
  <div class="mx-auto w-full max-w-6xl px-6">
    <div class="text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Características</p>
      <h2 class="mt-3 text-3xl font-bold text-slate-900">Una plataforma, todo lo que necesitas</h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-500">Desde la gestión de miembros hasta los reportes avanzados, igle·org cubre todo el ciclo de vida de tu comunidad.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <%
        features = [
          {
            title: "Gestión de miembros",
            desc: "Perfiles completos con foto, estado, familia, ministerio, habilidades y ocupación.",
            icon: "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z",
            color: "violet"
          },
          {
            title: "Ministerios y junta",
            desc: "Organiza equipos de trabajo, asigna líderes y gestiona la junta directiva.",
            icon: "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z",
            color: "sky"
          },
          {
            title: "Eventos y asistencia",
            desc: "Crea eventos, toma asistencia en tiempo real y registra RSVPs de los miembros.",
            icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5",
            color: "emerald"
          },
          {
            title: "Roles y permisos dinámicos",
            desc: "Matriz de permisos por módulo, acción y alcance. Sin hardcodear nombres de rol.",
            icon: "M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z",
            color: "amber"
          },
          {
            title: "Aislamiento multi-tenant",
            desc: "Cada iglesia es un espacio completamente independiente. Datos nunca se cruzan.",
            icon: "M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z",
            color: "rose"
          },
          {
            title: "Reportes y auditoría",
            desc: "Exporta datos, visualiza estadísticas y audita cambios importantes con paper_trail.",
            icon: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z",
            color: "indigo"
          }
        ]
        color_config = {
          "violet" => { bg: "bg-violet-50",  icon: "text-violet-600",  border: "border-violet-100" },
          "sky"    => { bg: "bg-sky-50",     icon: "text-sky-600",     border: "border-sky-100" },
          "emerald"=> { bg: "bg-emerald-50", icon: "text-emerald-600", border: "border-emerald-100" },
          "amber"  => { bg: "bg-amber-50",   icon: "text-amber-600",   border: "border-amber-100" },
          "rose"   => { bg: "bg-rose-50",    icon: "text-rose-600",    border: "border-rose-100" },
          "indigo" => { bg: "bg-indigo-50",  icon: "text-indigo-600",  border: "border-indigo-100" }
        }
      %>
      <% features.each do |feat| %>
        <% c = color_config[feat[:color]] %>
        <div class="group rounded-xl border border-slate-200 bg-white p-6 shadow-card transition-all duration-200 hover:shadow-card-hover hover:<%= c[:border] %>">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg <%= c[:bg] %> <%= c[:icon] %> transition-transform duration-200 group-hover:scale-110">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= feat[:icon] %>" />
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-slate-900"><%= feat[:title] %></h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500"><%= feat[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── CTA ── %>
<section class="bg-violet-700 py-16" style="background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 100%);">
  <div class="mx-auto w-full max-w-3xl px-6 text-center">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">Empieza a organizar tu iglesia hoy</h2>
    <p class="mx-auto mt-4 max-w-lg text-violet-200">
      Únete y descubre cómo igle·org puede simplificar la gestión de tu comunidad.
    </p>
    <% if user_signed_in? %>
      <%= link_to "Ir al panel", churches_path,
            class: "mt-8 inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-violet-700 hover:bg-violet-50 transition-colors" %>
    <% else %>
      <%= link_to "Iniciar sesión", new_user_session_path,
            class: "mt-8 inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-violet-700 hover:bg-violet-50 transition-colors" %>
    <% end %>
  </div>
</section>

<%# ── Footer ── %>
<footer class="border-t border-slate-100 bg-white py-8">
  <div class="mx-auto w-full max-w-6xl px-6 flex flex-col items-center gap-2 sm:flex-row sm:justify-between">
    <div class="flex items-center gap-2">
      <div class="flex h-6 w-6 items-center justify-center rounded-md bg-violet-600 text-white">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12 11.204 3.045c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
      </div>
      <span class="text-sm font-bold text-slate-700">igle<span class="text-violet-600">·org</span></span>
    </div>
    <p class="text-xs text-slate-400">© 2025 igle·org. Plataforma multi-tenant para iglesias.</p>
  </div>
</footer>
