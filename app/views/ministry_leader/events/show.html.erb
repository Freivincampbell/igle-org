<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="mb-6">
    <%= link_to "← Eventos", church_ministry_leader_events_path(@church), class: "text-sm text-slate-600 hover:text-violet-600 transition-colors" %>
  </div>

  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %> / <%= @event.ministry&.name %></p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @event.title %></h1>
    <p class="mt-1 text-sm text-slate-500">Estado: <%= @event.status %></p>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Detalles</h2>
      <dl class="mt-3 space-y-3 text-sm">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Inicio</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= l(@event.starts_at, format: :default) %></dd>
        </div>
        <% if @event.ends_at %>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Fin</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= l(@event.ends_at, format: :default) %></dd>
          </div>
        <% end %>
        <% if @event.location.present? %>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Lugar</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @event.location %></dd>
          </div>
        <% end %>
        <% if @event.capacity %>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Capacidad</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @event.capacity %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Confirmaciones</h2>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= @event.confirmed_attendees_count %></p>
      <ul class="mt-4 space-y-1 text-sm text-slate-600">
        <% @rsvps.each do |rsvp| %>
          <li><%= rsvp.member.full_name %> — <%= rsvp.status %></li>
        <% end %>
      </ul>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Asistencia real</h2>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= @event.attended_count %></p>
    </div>
  </div>

  <% if @event.description.present? %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Descripción</h2>
      <p class="mt-3 whitespace-pre-line text-sm text-slate-700"><%= @event.description %></p>
    </div>
  <% end %>
</section>
