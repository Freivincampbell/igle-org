<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Notas pastorales</h1>
      <p class="mt-1 text-sm text-slate-500">Acceso restringido solo a roles pastorales con permiso explicito.</p>
    </div>
    <% if policy(PastoralNote).create? %>
      <%= link_to "Nueva nota", new_church_pastor_pastoral_note_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
    <% end %>
  </div>

  <%= render "shared/table_toolbar",
        url: church_pastor_pastoral_notes_path(@church),
        frame_id: "table-pastoral-notes",
        label: "notas",
        q: params[:q],
        filters: [
          { param: :note_type, label: "Tipo",
            options: [["General", "general"], ["Consejería", "counseling"], ["Seguimiento", "follow_up"], ["Oración", "prayer"]],
            value: params[:note_type] }
        ] %>

  <turbo-frame id="table-pastoral-notes" data-turbo-action="advance" target="_top" class="mt-3 block">
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead>
          <tr>
            <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Miembro</th>
            <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Tipo</th>
            <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Pastor</th>
            <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Fecha</th>
            <th class="bg-slate-50 px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% if @notes.any? %>
            <% @notes.each do |note| %>
              <tr class="group hover:bg-slate-50/80 transition-colors">
                <td class="px-5 py-3 font-medium text-slate-900"><%= note.member.full_name %></td>
                <td class="px-5 py-3 text-slate-600"><%= pastoral_note_type_label(note.note_type) %></td>
                <td class="px-5 py-3 text-slate-600"><%= note.pastor.email %></td>
                <td class="px-5 py-3 text-slate-600"><%= l(note.created_at) %></td>
                <td class="px-5 py-3 text-right">
                  <div class="inline-flex items-center gap-2">
                    <%= link_to "Ver", church_pastor_pastoral_note_path(@church, note), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                    <% if policy(note).edit? %>
                      <%= link_to "Editar", edit_church_pastor_pastoral_note_path(@church, note), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="5" class="px-5 py-8 text-center text-slate-500">No hay notas registradas.</td></tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/table_pagination", pagy: @pagy %>
    </div>
  </turbo-frame>
</section>
