<section class="mx-auto w-full max-w-3xl px-6 py-10">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= @church.name %> · <%= @note.member.full_name %></p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-950"><%= @note.title.presence || pastoral_note_type_label(@note.note_type) %></h1>
      <p class="text-sm text-slate-500"><%= pastoral_note_type_label(@note.note_type) %> · <%= l(@note.created_at) %> · por <%= @note.pastor.email %></p>
    </div>
    <div class="flex gap-2">
      <% if policy(@note).edit? %>
        <%= link_to "Editar", edit_church_pastor_pastoral_note_path(@church, @note), class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if policy(@note).destroy? %>
        <%= button_to "Eliminar", church_pastor_pastoral_note_path(@church, @note), method: :delete, form_class: "inline-flex", class: "rounded-md border border-red-300 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-100", data: { turbo_confirm: "Eliminar esta nota?" } %>
      <% end %>
    </div>
  </div>

  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6">
    <p class="whitespace-pre-line text-sm text-slate-700"><%= @note.body %></p>
  </div>
</section>
