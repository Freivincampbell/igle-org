<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Notas pastorales</p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900">Editar nota pastoral</h1>
  </div>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <%= render "form", note: @note, url: church_pastor_pastoral_note_path(@church, @note), method: :patch %>
  </div>
</section>
