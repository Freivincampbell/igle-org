<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Mi perfil</h1>
    </div>
    <%= link_to "Solicitar cambio", new_church_member_portal_profile_change_request_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
  </div>

  <% if @member.photo.attached? %>
    <div class="mt-4">
      <%= image_tag @member.photo.variant(resize_to_fill: [80, 80]).processed,
            class: "h-20 w-20 rounded-full object-cover border border-slate-200" %>
    </div>
  <% end %>

  <% if @pending_request %>
    <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
      Ya tienes una solicitud pendiente de aprobacion.
    </div>
  <% end %>

  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <h2 class="text-base font-semibold text-slate-900">Información personal</h2>
    <dl class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Nombre</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @member.full_name %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Email</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @member.email %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Telefono</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @member.phone %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Estado civil</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= member_marital_status_label(@member.marital_status) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Direccion</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= [ @member.address_line_1, @member.city ].compact_blank.join(", ") %></dd>
      </div>
    </dl>
  </div>

  <%# ── Ocupaciones (self-service, sin aprobación) ── %>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <h2 class="text-base font-semibold text-slate-900">Mis ocupaciones</h2>

    <% if @member_occupations.any? %>
      <ul class="mt-4 divide-y divide-slate-100">
        <% @member_occupations.each do |mo| %>
          <li class="flex items-center justify-between gap-2 py-2.5 first:pt-0">
            <span class="text-sm font-medium text-slate-900">
              <%= mo.occupation&.name %>
              <% if mo.offers_services %>
                <span class="ml-1 inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-emerald-200">Ofrece servicios</span>
              <% end %>
            </span>
            <%= button_to "Quitar", church_member_portal_occupation_path(@church, mo.public_id), method: :delete,
                  class: "rounded-md px-2 py-1 text-xs font-medium text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-lg border border-dashed border-slate-200 py-4 text-center text-sm text-slate-400">Aún no agregaste ocupaciones.</p>
    <% end %>

    <%= form_with url: church_member_portal_occupations_path(@church), method: :post, class: "mt-4 flex flex-wrap items-center gap-3" do %>
      <input type="text" name="occupation_name" placeholder="Nueva ocupación" required
             class="flex-1 min-w-48 rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20">
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" name="offers_services" value="1" class="h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-500">
        Ofrezco servicios
      </label>
      <button type="submit" class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors cursor-pointer">Agregar</button>
    <% end %>
  </div>

  <%# ── Habilidades (self-service, sin aprobación) ── %>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <h2 class="text-base font-semibold text-slate-900">Mis habilidades</h2>

    <% if @member_skills.any? %>
      <ul class="mt-4 divide-y divide-slate-100">
        <% @member_skills.each do |ms| %>
          <li class="flex items-center justify-between gap-2 py-2.5 first:pt-0">
            <span class="text-sm font-medium text-slate-900">
              <%= ms.skill&.name %>
              <span class="ml-1 text-xs text-slate-500">· <%= skill_level_label(ms.level) %></span>
              <% if ms.offers_service %>
                <span class="ml-1 inline-flex rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-emerald-200">Ofrece servicios</span>
              <% end %>
            </span>
            <%= button_to "Quitar", church_member_portal_skill_path(@church, ms.public_id), method: :delete,
                  class: "rounded-md px-2 py-1 text-xs font-medium text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-lg border border-dashed border-slate-200 py-4 text-center text-sm text-slate-400">Aún no agregaste habilidades.</p>
    <% end %>

    <%= form_with url: church_member_portal_skills_path(@church), method: :post, class: "mt-4 flex flex-wrap items-center gap-3" do %>
      <input type="text" name="skill_name" placeholder="Nueva habilidad" required
             class="flex-1 min-w-48 rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20">
      <select name="level" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20">
        <% MemberSkill::LEVELS.each do |level| %>
          <option value="<%= level %>"><%= skill_level_label(level) %></option>
        <% end %>
      </select>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" name="offers_service" value="1" class="h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-500">
        Ofrezco servicios
      </label>
      <button type="submit" class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors cursor-pointer">Agregar</button>
    <% end %>
  </div>
</section>
