<section class="mx-auto w-full max-w-5xl px-6 py-10">
  <div class="mb-8">
    <h1 class="text-2xl font-semibold text-slate-950">Iglesias</h1>
    <p class="mt-2 text-sm text-slate-600">Selecciona una iglesia para trabajar dentro de su espacio independiente.</p>
  </div>

  <% if @churches.any? %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% @churches.each do |church| %>
        <%= link_to church_path(church), class: "block rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:shadow" do %>
          <p class="text-base font-medium text-slate-950"><%= church.name %></p>
          <p class="mt-2 text-sm text-slate-500"><%= church.public_id %></p>
          <span class="mt-4 inline-flex rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700"><%= church.status %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
      <p class="text-sm text-slate-600">No tienes iglesias activas asignadas.</p>
    </div>
  <% end %>
</section>
