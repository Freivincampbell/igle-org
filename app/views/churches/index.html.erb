<section class="mx-auto w-full max-w-5xl px-6 py-10">
  <div class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Tu cuenta</p>
    <h1 class="mt-1.5 text-2xl font-bold text-slate-900">Mis iglesias</h1>
    <p class="mt-2 text-sm text-slate-500">Selecciona una iglesia para acceder a su espacio de administración.</p>
  </div>

  <% if @churches.any? %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @churches.each do |church| %>
        <%= link_to church_path(church),
              class: "group relative overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-card transition-all duration-200 hover:shadow-card-hover hover:border-violet-200" do %>
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-xl font-bold text-violet-700 transition-transform duration-200 group-hover:scale-105">
              <%= church.name.first.upcase %>
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-slate-900 group-hover:text-violet-700 transition-colors"><%= church.name %></p>
              <p class="mt-0.5 text-xs text-slate-400 truncate"><%= church.public_id %></p>
              <span class="mt-3 inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold
                <%= church.status.to_s == 'active' ? 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200' : 'bg-slate-100 text-slate-600 ring-1 ring-slate-200' %>">
                <%= church.status %>
              </span>
            </div>
            <svg class="h-4 w-4 shrink-0 text-slate-300 transition-colors group-hover:text-violet-400 mt-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center rounded-xl border-2 border-dashed border-slate-200 bg-white py-16 text-center">
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
        </svg>
      </div>
      <p class="mt-4 text-base font-semibold text-slate-600">No tienes iglesias activas.</p>
      <p class="mt-1.5 text-sm text-slate-400">Contacta al administrador de la plataforma para ser agregado.</p>
    </div>
  <% end %>
</section>
