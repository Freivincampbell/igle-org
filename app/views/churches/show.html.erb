<section class="mx-auto w-full max-w-7xl px-6 py-10">
  <%= link_to "← Volver a iglesias", churches_path, class: "text-sm font-medium text-slate-600 hover:text-slate-950" %>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Mi iglesia</p>
        <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @church.name %></h1>
        <p class="mt-1 text-xs text-slate-400 font-mono"><%= @church.public_id %></p>
      </div>

      <div class="flex flex-wrap gap-3">
        <% if policy(Role).index? %>
          <%= link_to "Roles", church_admin_roles_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
        <% end %>
        <% if policy(ChurchMembership).index? %>
          <%= link_to "Usuarios", church_admin_memberships_path(@church), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
        <% end %>
        <% if policy(Member).index? %>
          <%= link_to "Miembros", church_admin_members_path(@church), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
        <% end %>
        <% if policy(Ministry).index? %>
          <%= link_to "Ministerios", church_admin_ministries_path(@church), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
        <% end %>
        <% if @church.active? %>
          <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><%= @church.status %></span>
        <% else %>
          <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-slate-200"><%= @church.status %></span>
        <% end %>
      </div>
    </div>

    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Email</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @church.email.presence || "No definido" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Telefono</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @church.phone.presence || "No definido" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Zona horaria</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @church.time_zone %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Idioma</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @church.locale %></dd>
      </div>
    </dl>
  </div>
</section>
