<section class="mx-auto w-full max-w-5xl px-6 py-10">
  <%= link_to "Volver a iglesias", churches_path, class: "text-sm font-medium text-slate-600 hover:text-slate-950" %>

  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-slate-950"><%= @church.name %></h1>
        <p class="mt-2 text-sm text-slate-500"><%= @church.public_id %></p>
      </div>

      <div class="flex flex-wrap gap-3">
        <% if policy(Role).index? %>
          <%= link_to "Roles", church_admin_roles_path(@church), class: "inline-flex items-center justify-center rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
        <% end %>
        <% if policy(ChurchMembership).index? %>
          <%= link_to "Usuarios", church_admin_memberships_path(@church), class: "inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
        <% end %>
        <% if policy(Member).index? %>
          <%= link_to "Miembros", church_admin_members_path(@church), class: "inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
        <% end %>
        <span class="inline-flex w-fit rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700"><%= @church.status %></span>
      </div>
    </div>

    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Email</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @church.email.presence || "No definido" %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Telefono</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @church.phone.presence || "No definido" %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Zona horaria</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @church.time_zone %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Idioma</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @church.locale %></dd>
      </div>
    </dl>
  </div>
</section>
