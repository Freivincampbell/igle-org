<%
  stat_cards = [
    {
      key:   :members_active,
      label: "Miembros activos",
      sub:   "de #{@stats[:members_total]} totales",
      path:  church_admin_members_path(@church),
      color: "violet",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />'
    },
    {
      key:   :families_total,
      label: "Familias registradas",
      sub:   "en la iglesia",
      path:  church_admin_families_path(@church),
      color: "rose",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />'
    },
    {
      key:   :ministries_active,
      label: "Ministerios activos",
      sub:   "en funcionamiento",
      path:  church_admin_ministries_path(@church),
      color: "sky",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />'
    },
    {
      key:   :events_upcoming,
      label: "Eventos próximos",
      sub:   "programados",
      path:  church_admin_events_path(@church),
      color: "emerald",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />'
    },
    {
      key:   :pending_requests,
      label: "Solicitudes pendientes",
      sub:   "requieren revisión",
      path:  church_admin_profile_change_requests_path(@church),
      color: @stats[:pending_requests] > 0 ? "amber" : "slate",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />'
    }
  ]

  color_cfg = {
    "violet" => { bg: "bg-violet-50", icon: "text-violet-600", num: "text-violet-700", border: "border-violet-100", hover: "hover:border-violet-200" },
    "rose"   => { bg: "bg-rose-50",   icon: "text-rose-500",   num: "text-rose-700",   border: "border-rose-100",   hover: "hover:border-rose-200" },
    "sky"    => { bg: "bg-sky-50",    icon: "text-sky-600",    num: "text-sky-700",    border: "border-sky-100",    hover: "hover:border-sky-200" },
    "emerald"=> { bg: "bg-emerald-50",icon: "text-emerald-600",num: "text-emerald-700",border: "border-emerald-100",hover: "hover:border-emerald-200" },
    "amber"  => { bg: "bg-amber-50",  icon: "text-amber-600",  num: "text-amber-700",  border: "border-amber-200",  hover: "hover:border-amber-300" },
    "slate"  => { bg: "bg-slate-50",  icon: "text-slate-400",  num: "text-slate-700",  border: "border-slate-200",  hover: "hover:border-slate-300" }
  }
%>

<section class="mx-auto w-full max-w-7xl px-6 py-8">

  <%# ── Back link ── %>
  <%= link_to churches_path,
        class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors animate-fade-in" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Volver a mis iglesias
  <% end %>

  <%# ── Hero card ── %>
  <div class="relative mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card animate-fade-in-up" style="animation-delay: 60ms">

    <%# decorative gradient blob %>
    <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-violet-100 opacity-60 blur-3xl"></div>
    <div class="pointer-events-none absolute right-24 -top-8 h-32 w-32 rounded-full bg-indigo-100 opacity-50 blur-2xl"></div>

    <%# top accent bar %>
    <div class="h-1 w-full bg-gradient-to-r from-violet-500 via-purple-500 to-indigo-500"></div>

    <div class="px-6 py-6">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">

        <%# Left: logo + identity %>
        <div class="flex items-center gap-4">
          <% if @church.logo.attached? %>
            <%= image_tag @church.logo.variant(resize_to_fill: [64, 64]).processed,
                  class: "h-16 w-16 rounded-xl object-cover ring-2 ring-violet-100 shadow-sm shrink-0" %>
          <% else %>
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 text-2xl font-bold text-white shadow-sm ring-2 ring-violet-100">
              <%= @church.name.first(2).upcase %>
            </div>
          <% end %>

          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Mi iglesia</p>
            <h1 class="mt-0.5 text-2xl font-bold text-slate-900"><%= @church.name %></h1>
            <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
              <% if @church.email.present? %>
                <span class="flex items-center gap-1">
                  <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                  </svg>
                  <%= @church.email %>
                </span>
              <% end %>
              <% if @church.phone.present? %>
                <span class="flex items-center gap-1">
                  <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                  </svg>
                  <%= @church.phone %>
                </span>
              <% end %>
              <span class="flex items-center gap-1">
                <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253M3 12a8.959 8.959 0 0 0 .284 2.253" />
                </svg>
                <%= @church.time_zone %>
              </span>
            </div>
          </div>
        </div>

        <%# Right: status + actions %>
        <div class="flex flex-wrap items-center gap-2 sm:shrink-0">
          <% if @church.active? %>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              Activa
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">
              <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
              Inactiva
            </span>
          <% end %>

          <% if policy(Role).index? %>
            <%= link_to "Roles", church_admin_roles_path(@church),
                  class: "rounded-lg bg-violet-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
          <% end %>
          <% if policy(ChurchMembership).index? %>
            <%= link_to "Usuarios", church_admin_memberships_path(@church),
                  class: "rounded-lg border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
          <% end %>
          <% if policy(Ministry).index? %>
            <%= link_to "Ministerios", church_admin_ministries_path(@church),
                  class: "rounded-lg border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Stat cards ── %>
  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    <% stat_cards.each_with_index do |stat, i| %>
      <% c = color_cfg[stat[:color]] %>
      <% val = @stats[stat[:key]] %>
      <%= link_to stat[:path],
            class: "group relative overflow-hidden rounded-xl border #{c[:border]} bg-white p-4 shadow-card transition-all duration-200 hover:shadow-card-hover #{c[:hover]} animate-fade-in-up",
            style: "animation-delay: #{100 + i * 70}ms" do %>

        <%# subtle tint fill on hover via pseudo — using a simple bg overlay trick %>
        <div class="flex items-start justify-between gap-2">
          <div class="rounded-lg <%= c[:bg] %> p-2.5 transition-transform duration-200 group-hover:scale-110">
            <svg class="h-5 w-5 <%= c[:icon] %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <%= stat[:icon].html_safe %>
            </svg>
          </div>

          <% if stat[:key] == :pending_requests && val > 0 %>
            <span class="mt-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-amber-500 text-[10px] font-bold text-white"><%= val > 9 ? "9+" : val %></span>
          <% end %>
        </div>

        <div data-controller="count-up" data-count-up-end-value="<%= val %>" class="mt-3">
          <p class="text-2xl font-bold <%= c[:num] %>">
            <span data-count-up-target="value"><%= val %></span>
          </p>
        </div>
        <p class="mt-0.5 text-xs font-semibold text-slate-700"><%= stat[:label] %></p>
        <p class="mt-0.5 text-[11px] text-slate-400"><%= stat[:sub] %></p>
        <p class="mt-2 text-[11px] font-medium text-slate-300 transition-colors group-hover:<%= c[:icon] %>">Ver detalles →</p>
      <% end %>
    <% end %>
  </div>

  <%# ── Main content grid ── %>
  <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">

    <%# Próximos eventos %>
    <div class="animate-fade-in-up rounded-xl border border-slate-200 bg-white shadow-card overflow-hidden" style="animation-delay: 450ms">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
        <div class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-50">
            <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
          </div>
          <h2 class="text-sm font-semibold text-slate-900">Próximos eventos</h2>
        </div>
        <%= link_to "Ver todos →", church_admin_events_path(@church),
              class: "text-xs font-medium text-violet-600 hover:text-violet-700 transition-colors" %>
      </div>

      <% if @upcoming_events.any? %>
        <ul class="divide-y divide-slate-50">
          <% @upcoming_events.each do |event| %>
            <li class="flex items-center gap-3 px-5 py-3 hover:bg-slate-50/70 transition-colors">
              <%# Calendar date badge %>
              <div class="flex h-10 w-10 shrink-0 flex-col items-center justify-center rounded-lg bg-violet-50 ring-1 ring-violet-100">
                <span class="text-[10px] font-semibold uppercase leading-none text-violet-400"><%= I18n.l(event.starts_at.to_date, format: "%b") %></span>
                <span class="text-base font-bold leading-tight text-violet-700"><%= event.starts_at.day %></span>
              </div>

              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-slate-900"><%= event.title %></p>
                <div class="mt-0.5 flex items-center gap-2 text-xs text-slate-500">
                  <span><%= I18n.l(event.starts_at, format: :time) rescue event.starts_at.strftime("%H:%M") %></span>
                  <% if event.ministry %>
                    <span class="inline-flex items-center rounded-md bg-violet-50 px-1.5 py-0.5 text-[10px] font-medium text-violet-600 ring-1 ring-violet-100">
                      <%= event.ministry.name %>
                    </span>
                  <% end %>
                </div>
              </div>

              <%= link_to "Ver", church_admin_event_path(@church, event),
                    class: "shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
            </li>
          <% end %>
        </ul>

        <% if @stats[:events_upcoming] > 5 %>
          <div class="border-t border-slate-50 px-5 py-3">
            <%= link_to "+ #{@stats[:events_upcoming] - 5} eventos más", church_admin_events_path(@church),
                  class: "text-xs font-medium text-violet-500 hover:text-violet-700 transition-colors" %>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center py-12 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
            <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
          </div>
          <p class="mt-3 text-sm text-slate-500">No hay eventos próximos</p>
          <% if policy(Event).new? %>
            <%= link_to "Crear evento", new_church_admin_event_path(@church),
                  class: "mt-2 text-xs font-medium text-violet-600 hover:text-violet-700 transition-colors" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Miembros recientes %>
    <div class="animate-fade-in-up rounded-xl border border-slate-200 bg-white shadow-card overflow-hidden" style="animation-delay: 520ms">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
        <div class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-violet-50">
            <svg class="h-4 w-4 text-violet-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
          </div>
          <h2 class="text-sm font-semibold text-slate-900">Miembros recientes</h2>
        </div>
        <%= link_to "Ver todos →", church_admin_members_path(@church),
              class: "text-xs font-medium text-violet-600 hover:text-violet-700 transition-colors" %>
      </div>

      <% if @recent_members.any? %>
        <ul class="divide-y divide-slate-50">
          <% @recent_members.each do |member| %>
            <li class="flex items-center gap-3 px-5 py-3 hover:bg-slate-50/70 transition-colors">
              <% if member.photo.attached? %>
                <%= image_tag member.photo.variant(resize_to_fill: [36, 36]).processed,
                      class: "h-9 w-9 shrink-0 rounded-full object-cover ring-2 ring-white shadow-sm" %>
              <% else %>
                <%
                  avatar_colors = %w[bg-violet-100 text-violet-700 bg-sky-100 text-sky-700 bg-emerald-100 text-emerald-700 bg-rose-100 text-rose-700 bg-amber-100 text-amber-700 bg-indigo-100 text-indigo-700]
                  seed = member.public_id.bytes.first(4).sum % 6
                  bg   = avatar_colors[seed * 2]
                  fg   = avatar_colors[seed * 2 + 1]
                %>
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= bg %> text-xs font-bold <%= fg %> ring-2 ring-white shadow-sm">
                  <%= member.first_name&.first&.upcase %><%= member.last_name&.first&.upcase %>
                </div>
              <% end %>

              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-slate-900"><%= member.full_name %></p>
                <p class="text-xs text-slate-400">Ingresó <%= time_ago_in_words(member.created_at) %> atrás</p>
              </div>

              <%= link_to "Ver", church_admin_member_path(@church, member),
                    class: "shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
            </li>
          <% end %>
        </ul>

        <% if @stats[:members_total] > 5 %>
          <div class="border-t border-slate-50 px-5 py-3">
            <%= link_to "+ #{@stats[:members_total] - 5} miembros más", church_admin_members_path(@church),
                  class: "text-xs font-medium text-violet-500 hover:text-violet-700 transition-colors" %>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center py-12 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
            <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <p class="mt-3 text-sm text-slate-500">Sin miembros registrados</p>
          <% if policy(Member).new? %>
            <%= link_to "Agregar miembro", new_church_admin_member_path(@church),
                  class: "mt-2 text-xs font-medium text-violet-600 hover:text-violet-700 transition-colors" %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>

  <%# ── Pending requests alert ── %>
  <% if @pending_requests.any? %>
    <div class="mt-5 animate-fade-in-up rounded-xl border border-amber-200 bg-white shadow-card overflow-hidden" style="animation-delay: 600ms">
      <div class="flex items-center justify-between border-b border-amber-100 bg-amber-50/60 px-5 py-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-100">
            <svg class="h-4 w-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
          </div>
          <h2 class="text-sm font-semibold text-amber-900">Solicitudes de cambio pendientes</h2>
          <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-amber-500 px-1.5 text-[10px] font-bold text-white">
            <%= @stats[:pending_requests] %>
          </span>
        </div>
        <%= link_to "Ver todas →", church_admin_profile_change_requests_path(@church),
              class: "text-xs font-medium text-amber-700 hover:text-amber-900 transition-colors" %>
      </div>

      <ul class="divide-y divide-amber-50/50">
        <% @pending_requests.each do |req| %>
          <li class="flex items-center justify-between gap-4 px-5 py-3 hover:bg-amber-50/40 transition-colors">
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold text-slate-900"><%= req.member.full_name %></p>
              <p class="text-xs text-slate-500">Solicitado <%= time_ago_in_words(req.created_at) %> atrás</p>
            </div>
            <%= link_to "Revisar", church_admin_profile_change_request_path(@church, req),
                  class: "shrink-0 rounded-lg bg-amber-100 px-3 py-1.5 text-xs font-semibold text-amber-800 hover:bg-amber-200 transition-colors" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

</section>
