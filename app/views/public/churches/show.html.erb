<% content_for :title, @church.name %>
<%
  accent = church_accent_color(@church)
  accent2 = church_accent_secondary_color(@church)
  maps_url = church_maps_url(@church)
  whatsapp_url = church_whatsapp_url(@church)
  address = church_address_line(@church)
  socials = {
    instagram: @church.instagram_url,
    facebook: @church.facebook_url,
    youtube: @church.youtube_url,
    website: @church.website
  }.compact_blank
  has_contact = @church.email.present? || @church.phone.present? || socials.any?
%>

<%# ── Navbar (sticky) ── %>
<header class="sticky top-0 z-30 backdrop-blur" style="background: <%= accent %>;">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 text-white">
    <a href="#top" class="flex items-center gap-2 font-semibold tracking-tight">
      <% if @church.logo.attached? %>
        <%= image_tag @church.logo.variant(resize_to_limit: [ 64, 64 ]).processed, alt: @church.name, class: "h-8 w-8 rounded-full object-cover ring-2 ring-white/40" %>
      <% else %>
        <span class="grid h-8 w-8 place-items-center rounded-full bg-white/20 text-sm font-bold"><%= @church.name.first(2).upcase %></span>
      <% end %>
      <span class="truncate"><%= @church.name %></span>
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium text-white/90">
      <% if @service_times.any? %><a href="#cultos" class="hidden sm:inline hover:text-white">Cultos</a><% end %>
      <% if @upcoming_events.any? %><a href="#eventos" class="hidden sm:inline hover:text-white">Eventos</a><% end %>
      <% if address.present? %><a href="#ubicacion" class="hidden sm:inline hover:text-white">Ubicación</a><% end %>
      <% if has_contact %><a href="#contacto" class="rounded-full bg-white px-4 py-2 font-semibold" style="color: <%= accent %>;">Contáctanos</a><% end %>
    </nav>
  </div>
</header>

<%# ── Hero ── %>
<section id="top" class="relative overflow-hidden" style="background: linear-gradient(135deg, <%= accent %> 0%, <%= accent2 %> 100%);">
  <div class="absolute inset-0 bg-black/10"></div>
  <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-white/10"></div>
  <div class="absolute -left-16 bottom-10 h-44 w-44 rounded-full bg-white/5"></div>
  <div class="relative mx-auto max-w-3xl px-6 pb-24 pt-20 text-center text-white">
    <% if @church.logo.attached? %>
      <%= image_tag @church.logo.variant(resize_to_limit: [ 200, 200 ]).processed, alt: @church.name,
            class: "mx-auto h-24 w-24 rounded-full object-cover shadow-lg ring-4 ring-white/30" %>
    <% else %>
      <span class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-white text-2xl font-extrabold shadow-lg" style="color: <%= accent %>;"><%= @church.name.first(2).upcase %></span>
    <% end %>
    <h1 class="mt-7 text-4xl font-extrabold tracking-tight sm:text-5xl"><%= @church.name %></h1>
    <% if @church.description.present? %>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/90"><%= @church.description %></p>
    <% end %>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <% if @upcoming_events.any? %>
        <a href="#eventos" class="rounded-full bg-white px-7 py-3.5 text-sm font-semibold shadow-lg transition hover:opacity-90" style="color: <%= accent %>;">Ver próximos eventos</a>
      <% end %>
      <% if @service_times.any? %>
        <a href="#cultos" class="rounded-full border border-white/50 px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10">Horarios de culto</a>
      <% end %>
    </div>
  </div>
  <svg class="relative block w-full text-slate-50" viewBox="0 0 1440 80" preserveAspectRatio="none" style="height:48px" aria-hidden="true">
    <path fill="currentColor" d="M0,40 C360,90 1080,0 1440,40 L1440,80 L0,80 Z"></path>
  </svg>
</section>

<%# ── Cultos + Eventos ── %>
<% if @service_times.any? || @upcoming_events.any? %>
  <section class="mx-auto grid max-w-6xl gap-10 px-6 py-16 lg:grid-cols-2">
    <% if @service_times.any? %>
      <div id="cultos">
        <p class="text-xs font-bold uppercase tracking-widest" style="color: <%= accent %>;">Horarios de culto</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Reúnete con nosotros</h2>
        <div class="mt-6 divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <% @service_times.each do |service_time| %>
            <div class="flex items-center justify-between gap-3 px-6 py-5">
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl" style="background: <%= accent %>1a; color: <%= accent %>;">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 6v6l4 2"/></svg>
                </span>
                <div>
                  <p class="font-semibold text-slate-900"><%= service_time.day_name %> · <%= service_time.name %></p>
                  <% if service_time.location.present? %><p class="text-sm text-slate-500"><%= service_time.location %></p><% end %>
                </div>
              </div>
              <span class="shrink-0 font-semibold text-slate-700">
                <%= service_time.starts_at.strftime("%H:%M") %><% if service_time.ends_at.present? %> – <%= service_time.ends_at.strftime("%H:%M") %><% end %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @upcoming_events.any? %>
      <div id="eventos">
        <p class="text-xs font-bold uppercase tracking-widest" style="color: <%= accent %>;">Próximos eventos</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">No te lo pierdas</h2>
        <div class="mt-6 space-y-4">
          <% @upcoming_events.each do |event| %>
            <%= link_to public_church_event_path(@church.slug, event),
                  class: "flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" do %>
              <span class="grid h-16 w-16 shrink-0 place-items-center rounded-xl text-white" style="background: <%= accent %>;">
                <span class="text-xs font-medium uppercase"><%= l(event.starts_at, format: "%b") %></span>
                <span class="-mt-1 text-2xl font-extrabold"><%= event.starts_at.day %></span>
              </span>
              <div class="min-w-0">
                <p class="truncate font-semibold text-slate-900"><%= event.title %></p>
                <p class="text-sm text-slate-500">
                  <%= l(event.starts_at, format: :time) %><% if event.location.present? %> · <%= event.location %><% end %>
                </p>
              </div>
              <span class="ml-auto text-slate-300" aria-hidden="true">→</span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>

<%# ── Directorio de servicios (teaser) ── %>
<% if @church.service_directory_enabled? %>
  <section class="border-y border-slate-100 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-14 text-center">
      <p class="text-xs font-bold uppercase tracking-widest" style="color: <%= accent %>;">Directorio de servicios</p>
      <h2 class="mt-2 text-2xl font-bold text-slate-900">Servicios de nuestra comunidad</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600">Miembros de la iglesia ofrecen sus oficios y profesiones. Escríbenos y te ponemos en contacto.</p>
      <% if has_contact %>
        <a href="#contacto" class="mt-5 inline-block rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-90" style="background: <%= accent %>;">Contáctanos</a>
      <% end %>
    </div>
  </section>
<% end %>

<%# ── Ubicación ── %>
<% if address.present? %>
  <section id="ubicacion" class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid items-center gap-8 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest" style="color: <%= accent %>;">Ubicación</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Visítanos</h2>
        <p class="mt-3 text-slate-600"><%= address %></p>
        <% if maps_url %>
          <a href="<%= maps_url %>" target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-90" style="background: <%= accent %>;">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
            Cómo llegar
          </a>
        <% end %>
      </div>
      <div class="grid h-44 place-items-center rounded-2xl border border-slate-200 bg-slate-100 text-slate-400">
        <svg class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
      </div>
    </div>
  </section>
<% end %>

<%# ── Footer / Contacto ── %>
<% if has_contact %>
  <footer id="contacto" class="bg-slate-900 text-slate-300">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-6 py-12 sm:flex-row">
      <div class="text-center sm:text-left">
        <p class="font-semibold text-white"><%= @church.name %></p>
        <p class="mt-1 text-sm text-slate-400">
          <%= [ @church.email, @church.phone ].compact_blank.join(" · ") %>
        </p>
      </div>
      <% if socials.any? %>
        <div class="flex items-center gap-3">
          <% if socials[:instagram] %><a href="<%= socials[:instagram] %>" target="_blank" rel="noopener" aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition hover:bg-white/20"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 5a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm5.5-3a1 1 0 110 2 1 1 0 010-2z"/></svg></a><% end %>
          <% if socials[:facebook] %><a href="<%= socials[:facebook] %>" target="_blank" rel="noopener" aria-label="Facebook" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition hover:bg-white/20"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M13 22v-9h3l.5-3.5H13V7.2c0-1 .3-1.7 1.8-1.7H17V2.3C16.6 2.2 15.5 2 14.3 2 11.7 2 10 3.6 10 6.5v3H7V13h3v9h3z"/></svg></a><% end %>
          <% if socials[:youtube] %><a href="<%= socials[:youtube] %>" target="_blank" rel="noopener" aria-label="YouTube" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition hover:bg-white/20"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23 7s-.2-1.6-.8-2.3c-.8-.9-1.7-.9-2.1-.9C17.2 3.5 12 3.5 12 3.5s-5.2 0-8.1.3c-.4 0-1.3 0-2.1.9C1.2 5.4 1 7 1 7S.8 8.9.8 10.8v1.4C.8 14 1 16 1 16s.2 1.6.8 2.3c.8.9 1.9.9 2.4 1 1.7.1 7.8.2 7.8.2s5.2 0 8.1-.3c.4 0 1.3 0 2.1-.9.6-.7.8-2.3.8-2.3s.2-1.9.2-3.8v-1.4C23.2 8.9 23 7 23 7zM9.8 14.5v-5l4.5 2.5-4.5 2.5z"/></svg></a><% end %>
          <% if socials[:website] %><a href="<%= socials[:website] %>" target="_blank" rel="noopener" aria-label="Sitio web" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition hover:bg-white/20"><svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/></svg></a><% end %>
        </div>
      <% end %>
    </div>
  </footer>
<% end %>

<%# ── WhatsApp flotante ── %>
<% if whatsapp_url %>
  <a href="<%= whatsapp_url %>" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"
     class="fixed bottom-5 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-emerald-500 text-white shadow-lg transition hover:bg-emerald-600">
    <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 00-8.5 15.3L2 22l4.8-1.4A10 10 0 1012 2zm0 2a8 8 0 11-4.1 14.9l-.3-.2-2.8.8.8-2.7-.2-.3A8 8 0 0112 4z"/></svg>
  </a>
<% end %>
