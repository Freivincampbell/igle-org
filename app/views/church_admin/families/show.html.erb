<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @family.name %></h1>
      <p class="mt-1 text-sm text-slate-500">Estado: <%= family_status_label(@family.status) %></p>
    </div>
    <div class="flex gap-2">
      <% if policy(@family).edit? %>
        <%= link_to "Editar", edit_church_admin_family_path(@church, @family), class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <% end %>
      <% if @family.active? && policy(@family).deactivate? %>
        <%= button_to "Desactivar", deactivate_church_admin_family_path(@church, @family), method: :patch, form_class: "inline-flex", class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <% elsif @family.inactive? && policy(@family).activate? %>
        <%= button_to "Activar", activate_church_admin_family_path(@church, @family), method: :patch, form_class: "inline-flex", class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <% end %>
    </div>
  </div>

  <% if @family.notes.present? %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Notas</h2>
      <p class="mt-2 whitespace-pre-line text-sm text-slate-700"><%= @family.notes %></p>
    </div>
  <% end %>

  <%# ── Member management card ── %>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white shadow-card">
    <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <h2 class="text-base font-semibold text-slate-900">Miembros de la familia</h2>
        <p class="mt-0.5 text-sm text-slate-500">Asigna miembros, define su relación y marca el contacto principal.</p>
      </div>
      <span class="text-xs font-medium text-slate-400"><%= @current_family_members.size %> miembro<%= "s" if @current_family_members.size != 1 %></span>
    </div>

    <%= form_with url: members_church_admin_family_path(@church, @family), method: :patch do %>
      <% relationship_options = FamilyMember::RELATIONSHIPS.map { |r| [ family_relationship_label(r), r ] } %>

      <div data-controller="member-search"
           data-member-search-url-value="<%= search_church_admin_members_path(@church) %>">

        <%# ── Search input — always visible at the top ── %>
        <div class="border-b border-slate-100 px-6 py-4" data-member-search-target="searchArea">
          <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 focus-within:border-violet-400 focus-within:bg-white focus-within:ring-2 focus-within:ring-violet-200 transition-colors">
            <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <input type="text" placeholder="Buscar miembro por nombre para agregar..."
                   autocomplete="off"
                   data-member-search-target="input"
                   data-action="input->member-search#search keydown->member-search#keydown"
                   class="w-full bg-transparent py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none">
          </div>

          <%# Results dropdown — attached just below the search input %>
          <div class="relative">
            <turbo-frame id="member-results-family"
                         data-member-search-target="results"
                         class="absolute left-0 right-0 z-20 mt-1 block max-h-72 overflow-auto rounded-xl border border-slate-200 bg-white shadow-card empty:hidden">
            </turbo-frame>
          </div>
        </div>

        <%# ── Member list ── %>
        <div class="px-6">
          <%# Empty state — shown when no members %>
          <div data-member-search-target="emptyState"
               class="<%= @current_family_members.any? ? 'hidden' : '' %> flex flex-col items-center py-10 text-center">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
              <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
              </svg>
            </div>
            <p class="mt-3 text-sm font-medium text-slate-500">Sin miembros asignados</p>
            <p class="mt-1 text-xs text-slate-400">Busca un miembro arriba para comenzar a armar la familia</p>
          </div>

          <%# Member rows list %>
          <div data-member-search-target="tagsZone" class="divide-y divide-slate-50">
            <% @current_family_members.each do |public_id, fm| %>
              <%= render "church_admin/families/member_row",
                    public_id: public_id,
                    name: fm.member.full_name,
                    initials: member_initials(fm.member),
                    avatar_color: member_avatar_color(public_id),
                    ids_field: "family[member_public_ids][]",
                    meta_field: "family[member_relationships][#{public_id}]",
                    meta_options: relationship_options,
                    meta_selected: fm.relationship,
                    primary_field: "family[primary_contact_public_id]",
                    primary_checked: fm.primary_contact %>
            <% end %>
          </div>
        </div>

        <%# Template for JS cloning (hidden) %>
        <template data-member-search-target="template">
          <%= render "church_admin/families/member_row",
                public_id: "__ID__",
                name: "",
                initials: "",
                avatar_color: "bg-violet-100 text-violet-700",
                ids_field: "family[member_public_ids][]",
                meta_field: "family[member_relationships][__ID__]",
                meta_options: relationship_options,
                meta_selected: "other",
                primary_field: "family[primary_contact_public_id]",
                primary_checked: false %>
        </template>

      </div>

      <% if policy(@family).update? %>
        <div class="flex items-center justify-between border-t border-slate-100 px-6 py-4">
          <p class="text-xs text-slate-400">Los cambios se guardan al presionar el botón</p>
          <%= submit_tag "Guardar miembros",
                class: "inline-flex items-center gap-2 rounded-lg bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
