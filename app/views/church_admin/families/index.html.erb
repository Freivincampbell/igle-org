<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Familias</h1>
    </div>

    <% if policy(Family).new? %>
      <%= link_to "Nueva familia", new_church_admin_family_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
    <% end %>
  </div>

  <%= render "shared/table_toolbar",
        url: church_admin_families_path(@church),
        frame_id: "table-families",
        label: "familias",
        q: params[:q],
        filters: [
          { param: :status, label: "Estado",
            options: [["Activa", "active"], ["Inactiva", "inactive"]],
            value: params[:status] }
        ] %>
  <turbo-frame id="table-families" data-turbo-action="advance" target="_top" class="mt-3 block">
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead>
        <tr>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Familia</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Miembros</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</th>
          <th class="bg-slate-50 px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @families.any? %>
          <% @families.each do |family| %>
            <tr class="group hover:bg-slate-50/80 transition-colors">
              <td class="px-5 py-4 font-medium text-slate-900"><%= family.name %></td>
              <td class="px-5 py-4 text-slate-600"><%= family.members.size %></td>
              <td class="px-5 py-4 text-slate-600"><%= family_status_label(family.status) %></td>
              <td class="px-5 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <% if policy(family).show? %>
                    <%= link_to "Ver", church_admin_family_path(@church, family), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                  <% if policy(family).edit? %>
                    <%= link_to "Editar", edit_church_admin_family_path(@church, family), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-5 py-10 text-center text-sm text-slate-500">No hay familias registradas.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/table_pagination", pagy: @pagy %>
  </div>
  </turbo-frame>
</section>
