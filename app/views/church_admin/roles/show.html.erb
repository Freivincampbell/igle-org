<section class="mx-auto w-full max-w-6xl px-6 py-10">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= @church.name %></p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-950"><%= @role.name %></h1>
      <p class="mt-2 text-sm text-slate-500"><%= @role.public_id %></p>
    </div>

    <div class="flex flex-wrap gap-3">
      <% if policy(@role).edit? %>
        <%= link_to "Editar", edit_church_admin_role_path(@church, @role), class: "inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if @role.active? && policy(@role).deactivate? %>
        <%= button_to "Desactivar", deactivate_church_admin_role_path(@church, @role), method: :patch, class: "rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100" %>
      <% elsif @role.inactive? && policy(@role).activate? %>
        <%= button_to "Activar", activate_church_admin_role_path(@church, @role), method: :patch, class: "rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100" %>
      <% end %>
    </div>
  </div>

  <dl class="mt-8 grid gap-4 rounded-lg border border-slate-200 bg-white p-6 sm:grid-cols-3">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Estado</dt>
      <dd class="mt-1 text-sm text-slate-900"><%= @role.status %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Tipo</dt>
      <dd class="mt-1 text-sm text-slate-900"><%= @role.pastoral? ? "Pastoral" : "General" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Permisos</dt>
      <dd class="mt-1 text-sm text-slate-900"><%= @role.permissions.count %></dd>
    </div>
  </dl>

  <div class="mt-8 rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="text-xl font-semibold text-slate-950">Permisos asignados</h2>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <% @role.permissions.ordered.group_by(&:module_key).each do |module_key, module_permissions| %>
        <section class="rounded-md border border-slate-200 p-4">
          <h3 class="font-medium text-slate-950"><%= permission_module_label(module_key) %></h3>
          <div class="mt-3 flex flex-wrap gap-2">
            <% module_permissions.each do |permission| %>
              <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700"><%= permission_action_label(permission.action_key) %></span>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @role.permissions.none? %>
        <p class="text-sm text-slate-500">No hay permisos asignados.</p>
      <% end %>
    </div>
  </div>
</section>
