<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @role.name %></h1>
      <p class="mt-1 text-xs text-slate-400"><%= @role.public_id %></p>
    </div>

    <div class="flex flex-wrap gap-3">
      <% if policy(@role).edit? %>
        <%= link_to "Editar", edit_church_admin_role_path(@church, @role), class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <% end %>
      <% if @role.active? && policy(@role).deactivate? %>
        <%= button_to "Desactivar", deactivate_church_admin_role_path(@church, @role), method: :patch, class: "inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100 transition-colors" %>
      <% elsif @role.inactive? && policy(@role).activate? %>
        <%= button_to "Activar", activate_church_admin_role_path(@church, @role), method: :patch, class: "inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100 transition-colors" %>
      <% end %>
    </div>
  </div>

  <dl class="mt-8 grid gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-card sm:grid-cols-3">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</dt>
      <dd class="mt-1 text-sm text-slate-900"><%= @role.status %></dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Tipo</dt>
      <dd class="mt-2">
        <% if @role.pastoral? %>
          <span class="inline-flex rounded-full bg-violet-50 px-2.5 py-0.5 text-xs font-semibold text-violet-700 ring-1 ring-violet-200">Pastoral</span>
        <% else %>
          <span class="text-sm text-slate-900">General</span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Permisos</dt>
      <dd class="mt-1 text-sm text-slate-900"><%= @role.permissions.count %></dd>
    </div>
  </dl>

  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <h2 class="text-base font-semibold text-slate-900">Permisos asignados</h2>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <% @role.permissions.ordered.group_by(&:module_key).each do |module_key, module_permissions| %>
        <section class="rounded-lg border border-slate-200 p-4">
          <h3 class="text-sm font-semibold text-slate-900"><%= permission_module_label(module_key) %></h3>
          <div class="mt-3 flex flex-wrap gap-2">
            <% module_permissions.each do |permission| %>
              <span class="rounded-md bg-violet-50 px-2.5 py-1 text-xs font-semibold text-violet-700 ring-1 ring-violet-200"><%= permission_action_label(permission.action_key) %></span>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @role.permissions.none? %>
        <p class="text-sm text-slate-500">No hay permisos asignados.</p>
      <% end %>
    </div>
  </div>
</section>
