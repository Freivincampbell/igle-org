<section class="mx-auto w-full max-w-3xl px-6 py-10">
  <div>
    <p class="text-sm font-medium text-slate-500"><%= @church.name %></p>
    <h1 class="mt-2 text-3xl font-semibold text-slate-950">Solicitud de <%= @request.member.full_name %></h1>
    <p class="text-sm text-slate-500">Estado: <%= profile_change_request_status_label(@request.status) %> · Solicitada el <%= l(@request.created_at) %></p>
  </div>

  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="text-sm font-semibold uppercase text-slate-500">Cambios propuestos</h2>
    <dl class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2 text-sm">
      <% @request.filtered_changes.each do |key, value| %>
        <div>
          <dt class="font-medium text-slate-700"><%= key.to_s.humanize %></dt>
          <dd class="text-slate-500">Actual: <%= @request.member.public_send(key) %></dd>
          <dd class="text-slate-950">Propuesto: <%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <% if @request.review_notes.present? %>
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-sm font-semibold uppercase text-slate-500">Notas de revision</h2>
      <p class="mt-2 whitespace-pre-line text-sm text-slate-700"><%= @request.review_notes %></p>
    </div>
  <% end %>

  <% if @request.pending? && policy(@request).review? %>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-end">
      <%= form_with url: reject_church_admin_profile_change_request_path(@church, @request), method: :patch, class: "flex flex-col gap-2 sm:flex-row sm:items-end" do %>
        <%= text_field_tag :review_notes, nil, placeholder: "Motivo (opcional)", class: "rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        <%= submit_tag "Rechazar", class: "rounded-md border border-red-300 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100" %>
      <% end %>
      <%= button_to "Aprobar y aplicar", approve_church_admin_profile_change_request_path(@church, @request), method: :patch, form_class: "inline-flex", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
    </div>
  <% end %>
</section>
