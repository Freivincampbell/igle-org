<section class="mx-auto w-full max-w-3xl px-6 py-8">
  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900">Solicitud de <%= @request.member.full_name %></h1>
    <p class="mt-1 text-sm text-slate-500">Estado: <%= profile_change_request_status_label(@request.status) %> · Solicitada el <%= l(@request.created_at) %></p>
  </div>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <h2 class="text-base font-semibold text-slate-900">Cambios propuestos</h2>
    <dl class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
      <% @request.filtered_changes.each do |key, value| %>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= key.to_s.humanize %></dt>
          <dd class="mt-1 text-sm text-slate-500">Actual: <%= @request.member.public_send(key) %></dd>
          <dd class="mt-0.5 text-sm font-medium text-slate-900">Propuesto: <%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <% if @request.review_notes.present? %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Notas de revision</h2>
      <p class="mt-2 whitespace-pre-line text-sm text-slate-700"><%= @request.review_notes %></p>
    </div>
  <% end %>

  <% if @request.pending? && policy(@request).review? %>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-end">
      <%= form_with url: reject_church_admin_profile_change_request_path(@church, @request), method: :patch, class: "flex flex-col gap-2 sm:flex-row sm:items-end" do %>
        <%= text_field_tag :review_notes, nil, placeholder: "Motivo (opcional)", class: "rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        <%= submit_tag "Rechazar", class: "inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100 transition-colors cursor-pointer" %>
      <% end %>
      <%= button_to "Aprobar y aplicar", approve_church_admin_profile_change_request_path(@church, @request), method: :patch, form_class: "inline-flex", class: "inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors" %>
    </div>
  <% end %>
</section>
