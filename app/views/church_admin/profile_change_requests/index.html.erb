<section class="mx-auto w-full max-w-6xl px-6 py-10">
  <div>
    <p class="text-sm font-medium text-slate-500"><%= @church.name %></p>
    <h1 class="mt-2 text-3xl font-semibold text-slate-950">Solicitudes de cambio</h1>
    <p class="text-sm text-slate-500">Cambios propuestos por miembros pendientes de aprobacion.</p>
  </div>

  <div class="mt-8 overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500">
        <tr>
          <th class="px-4 py-3">Miembro</th>
          <th class="px-4 py-3">Solicitada</th>
          <th class="px-4 py-3">Estado</th>
          <th class="px-4 py-3 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @requests.any? %>
          <% @requests.each do |req| %>
            <tr>
              <td class="px-4 py-3 font-medium text-slate-950"><%= req.member.full_name %></td>
              <td class="px-4 py-3 text-slate-600"><%= l(req.created_at) %></td>
              <td class="px-4 py-3 text-slate-600"><%= profile_change_request_status_label(req.status) %></td>
              <td class="px-4 py-3 text-right">
                <%= link_to "Revisar", church_admin_profile_change_request_path(@church, req), class: "font-medium text-slate-600 hover:text-slate-950" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-slate-500">No hay solicitudes registradas.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
