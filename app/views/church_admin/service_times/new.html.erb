<section class="mx-auto w-full max-w-3xl px-6 py-10">
  <div>
    <p class="text-sm font-medium text-slate-500"><%= @church.name %></p>
    <h1 class="mt-2 text-3xl font-semibold text-slate-950">Nuevo horario</h1>
  </div>

  <div class="mt-8 rounded-lg border border-slate-200 bg-white p-6">
    <%= render "form", service_time: @service_time, url: church_admin_service_times_path(@church), method: :post %>
  </div>
</section>
