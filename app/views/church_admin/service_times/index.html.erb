<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Horarios de cultos</h1>
    </div>

    <% if policy(ChurchServiceTime).new? %>
      <%= link_to new_church_admin_service_time_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
          <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
        </svg>
        Nuevo horario
      <% end %>
    <% end %>
  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead>
        <tr>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Nombre</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Dia</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Hora</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Lugar</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</th>
          <th class="bg-slate-50 px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @service_times.any? %>
          <% @service_times.each do |service_time| %>
            <tr class="group hover:bg-slate-50/80 transition-colors">
              <td class="px-5 py-4 font-medium text-slate-900"><%= service_time.name %></td>
              <td class="px-5 py-4 text-slate-600"><%= day_of_week_label(service_time.day_of_week) %></td>
              <td class="px-5 py-4 text-slate-600">
                <%= l(service_time.starts_at, format: :time) if service_time.starts_at %>
                <% if service_time.ends_at %> - <%= l(service_time.ends_at, format: :time) %><% end %>
              </td>
              <td class="px-5 py-4 text-slate-600"><%= service_time.location %></td>
              <td class="px-5 py-4 text-slate-600"><%= church_service_time_status_label(service_time.status) %></td>
              <td class="px-5 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <% if policy(service_time).edit? %>
                    <%= link_to "Editar", edit_church_admin_service_time_path(@church, service_time), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                  <% if service_time.active? && policy(service_time).deactivate? %>
                    <%= button_to "Desactivar", deactivate_church_admin_service_time_path(@church, service_time), method: :patch, form_class: "inline-flex", class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% elsif service_time.inactive? && policy(service_time).activate? %>
                    <%= button_to "Activar", activate_church_admin_service_time_path(@church, service_time), method: :patch, form_class: "inline-flex", class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="px-5 py-12 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto mb-3 size-10 text-slate-300">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              <p class="text-sm text-slate-500">No hay horarios registrados.</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
