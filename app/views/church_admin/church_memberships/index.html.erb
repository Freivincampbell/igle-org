<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Usuarios de iglesia</h1>
    </div>

    <% if policy(ChurchMembership).new? %>
      <%= link_to "Nuevo usuario", new_church_admin_membership_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
    <% end %>
  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead>
        <tr>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Usuario</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Roles</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</th>
          <th class="bg-slate-50 px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @church_memberships.any? %>
          <% @church_memberships.each do |membership| %>
            <tr class="group hover:bg-slate-50/80 transition-colors">
              <td class="px-5 py-4">
                <div class="font-medium text-slate-900"><%= membership.user.email %></div>
                <div class="mt-1 text-xs text-slate-500"><%= membership.owner? ? "Owner" : "Miembro" %></div>
              </td>
              <td class="px-5 py-4">
                <% if membership.roles.any? %>
                  <div class="flex flex-wrap gap-2">
                    <% membership.roles.order(:name).each do |role| %>
                      <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700"><%= role.name %></span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-slate-500">Sin roles</span>
                <% end %>
              </td>
              <td class="px-5 py-4 text-slate-600"><%= membership.status %></td>
              <td class="px-5 py-4 text-right">
                <div class="flex flex-wrap justify-end gap-2">
                  <% if policy(membership).edit? %>
                    <%= link_to "Editar", edit_church_admin_membership_path(@church, membership), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>

                  <% if membership.inactive? && policy(membership).activate? %>
                    <%= button_to "Activar", activate_church_admin_membership_path(@church, membership), method: :patch, form_class: "inline-flex", class: "rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 hover:bg-emerald-100 transition-colors" %>
                  <% end %>

                  <% if membership.active? && policy(membership).deactivate? %>
                    <%= button_to "Desactivar", deactivate_church_admin_membership_path(@church, membership), method: :patch, form_class: "inline-flex", class: "rounded-md bg-red-50 px-2.5 py-1 text-xs font-medium text-red-700 hover:bg-red-100 transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-5 py-8 text-center text-slate-500">No hay usuarios registrados.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
