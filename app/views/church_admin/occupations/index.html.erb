<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Catalogo de ocupaciones</h1>
    </div>
    <% if policy(Occupation).new? %>
      <%= link_to new_church_admin_occupation_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
          <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
        </svg>
        Nueva ocupacion
      <% end %>
    <% end %>
  </div>

  <%= render "shared/table_toolbar",
        url: church_admin_occupations_path(@church),
        frame_id: "table-occupations",
        label: "ocupaciones",
        q: params[:q],
        filters: [
          { param: :status, label: "Estado",
            options: [["Activa", "active"], ["Inactiva", "inactive"]],
            value: params[:status] }
        ] %>
  <turbo-frame id="table-occupations" data-turbo-action="advance" target="_top" class="mt-3 block">
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead>
        <tr>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Nombre</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</th>
          <th class="bg-slate-50 px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @occupations.any? %>
          <% @occupations.each do |occ| %>
            <tr class="group hover:bg-slate-50/80 transition-colors">
              <td class="px-5 py-4 font-medium text-slate-900"><%= occ.name %></td>
              <td class="px-5 py-4 text-slate-600"><%= occupation_status_label(occ.status) %></td>
              <td class="px-5 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <% if policy(occ).edit? %>
                    <%= link_to "Editar", edit_church_admin_occupation_path(@church, occ), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                  <% if occ.active? && policy(occ).deactivate? %>
                    <%= button_to "Desactivar", deactivate_church_admin_occupation_path(@church, occ), method: :patch, form_class: "inline-flex", class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% elsif occ.inactive? && policy(occ).activate? %>
                    <%= button_to "Activar", activate_church_admin_occupation_path(@church, occ), method: :patch, form_class: "inline-flex", class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="3" class="px-5 py-12 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto mb-3 size-10 text-slate-300">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
              </svg>
              <p class="text-sm text-slate-500">No hay ocupaciones registradas.</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/table_pagination", pagy: @pagy %>
  </div>
  </turbo-frame>
</section>
