<section class="mx-auto w-full max-w-5xl px-6 py-10">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= @church.name %></p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-950">Catalogo de ocupaciones</h1>
    </div>
    <% if policy(Occupation).new? %>
      <%= link_to "Nueva ocupacion", new_church_admin_occupation_path(@church), class: "inline-flex items-center justify-center rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
    <% end %>
  </div>

  <div class="mt-8 overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500">
        <tr><th class="px-4 py-3">Nombre</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3 text-right">Acciones</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @occupations.any? %>
          <% @occupations.each do |occ| %>
            <tr>
              <td class="px-4 py-3 font-medium text-slate-950"><%= occ.name %></td>
              <td class="px-4 py-3 text-slate-600"><%= occupation_status_label(occ.status) %></td>
              <td class="px-4 py-3 text-right">
                <% if policy(occ).edit? %>
                  <%= link_to "Editar", edit_church_admin_occupation_path(@church, occ), class: "font-medium text-slate-600 hover:text-slate-950" %>
                <% end %>
                <% if occ.active? && policy(occ).deactivate? %>
                  <%= button_to "Desactivar", deactivate_church_admin_occupation_path(@church, occ), method: :patch, form_class: "inline-flex ml-3", class: "font-medium text-slate-600 hover:text-slate-950" %>
                <% elsif occ.inactive? && policy(occ).activate? %>
                  <%= button_to "Activar", activate_church_admin_occupation_path(@church, occ), method: :patch, form_class: "inline-flex ml-3", class: "font-medium text-slate-600 hover:text-slate-950" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="3" class="px-4 py-8 text-center text-slate-500">No hay ocupaciones registradas.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
