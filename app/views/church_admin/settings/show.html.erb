<section class="mx-auto w-full max-w-4xl px-6 py-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Configuracion de iglesia</h1>
      <p class="mt-1 text-sm text-slate-600">Define la informacion publica, marca y opciones visibles de tu iglesia.</p>
    </div>
    <% if @church.slug.present? && @church.public_page_enabled? %>
      <%= link_to public_church_path(@church.slug),
            target: "_blank", rel: "noopener noreferrer",
            class: "mt-1 shrink-0 inline-flex items-center gap-2 rounded-lg border border-violet-200 bg-violet-50 px-4 py-2 text-sm font-semibold text-violet-700 hover:bg-violet-100 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        Ver perfil publico
      <% end %>
    <% else %>
      <span class="mt-1 shrink-0 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-400 cursor-not-allowed"
            title="<%= @church.slug.blank? ? 'Configura un slug para habilitar el perfil publico' : 'Habilita la pagina publica en Opciones para acceder' %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        Ver perfil publico
      </span>
    <% end %>
  </div>

  <% if @church.errors.any? %>
    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <ul class="list-inside list-disc space-y-1">
        <% @church.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @church, url: church_admin_settings_path(@church), method: :patch, html: { multipart: true }, class: "mt-8 space-y-8" do |form| %>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Identidad</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <%= form.label :name, "Nombre", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :name, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :legal_name, "Nombre legal", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :legal_name, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div data-controller="slug-validator"
             data-slug-validator-check-url-value="<%= check_slug_church_admin_settings_path(@church) %>"
             data-slug-validator-base-url-value="<%= request.base_url %>">
          <div class="flex items-center justify-between mb-1">
            <%= form.label :slug, "Slug publico", class: "block text-sm font-medium text-slate-700" %>
            <span data-slug-validator-target="badge" class="hidden text-xs font-medium rounded-full px-2 py-0.5"></span>
          </div>
          <%= form.text_field :slug,
                placeholder: "mi-iglesia",
                data: {
                  slug_validator_target: "input",
                  action: "input->slug-validator#sanitize"
                },
                class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
          <p data-slug-validator-target="urlHint"
             class="mt-1 text-xs text-slate-500 <%= 'hidden' unless @church.slug.present? %>">
            🔗 <%= request.base_url %>/c/<%= @church.slug %>
          </p>
        </div>
        <div class="md:col-span-2">
          <%= form.label :description, "Descripcion", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_area :description, rows: 3, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div class="md:col-span-2">
          <%= form.label :logo, "Logo (PNG, JPG o WEBP, max 5MB)", class: "block text-sm font-medium text-slate-700" %>
          <% if @church.logo.attached? %>
            <div class="mt-2">
              <%= image_tag @church.logo.variant(resize_to_limit: [ 200, 200 ]).processed, class: "h-20 w-20 rounded-md object-cover" %>
            </div>
          <% end %>
          <%= form.file_field :logo, accept: "image/png,image/jpeg,image/webp", class: "mt-2 block w-full text-sm text-slate-700 file:mr-4 file:cursor-pointer file:rounded-lg file:border-0 file:bg-violet-600 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-violet-700" %>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Contacto</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <%= form.label :email, "Email", class: "block text-sm font-medium text-slate-700" %>
          <%= form.email_field :email, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :phone, "Telefono", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :phone, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :whatsapp, "WhatsApp", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :whatsapp, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :website, "Sitio web", class: "block text-sm font-medium text-slate-700" %>
          <%= form.url_field :website, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :facebook_url, "Facebook", class: "block text-sm font-medium text-slate-700" %>
          <%= form.url_field :facebook_url, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :instagram_url, "Instagram", class: "block text-sm font-medium text-slate-700" %>
          <%= form.url_field :instagram_url, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :youtube_url, "YouTube", class: "block text-sm font-medium text-slate-700" %>
          <%= form.url_field :youtube_url, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Direccion</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="md:col-span-2">
          <%= form.label :address_line_1, "Direccion", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :address_line_1, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div class="md:col-span-2">
          <%= form.label :address_line_2, "Direccion (linea 2)", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :address_line_2, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :city, "Ciudad", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :city, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :state, "Provincia / Estado", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :state, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :postal_code, "Codigo postal", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :postal_code, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :country, "Pais", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :country, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Marca</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <%= form.label :primary_color, "Color primario (hex)", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :primary_color, placeholder: "#0F172A", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
        <div>
          <%= form.label :secondary_color, "Color secundario (hex)", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :secondary_color, placeholder: "#1E293B", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
      <h2 class="text-base font-semibold text-slate-900">Opciones</h2>
      <div class="mt-4 space-y-3">
        <label class="rounded-xl border border-slate-200 p-4 flex items-start gap-3 hover:bg-slate-50 transition-colors cursor-pointer">
          <%= form.check_box :public_page_enabled, class: "mt-0.5 h-4 w-4 rounded text-violet-600 focus:ring-violet-500" %>
          <span>
            <span class="block text-sm font-medium text-slate-900">Habilitar pagina publica</span>
            <span class="block text-xs text-slate-500">Permite mostrar la informacion basica de la iglesia en una URL publica.</span>
          </span>
        </label>
        <label class="rounded-xl border border-slate-200 p-4 flex items-start gap-3 hover:bg-slate-50 transition-colors cursor-pointer">
          <%= form.check_box :service_directory_enabled, class: "mt-0.5 h-4 w-4 rounded text-violet-600 focus:ring-violet-500" %>
          <span>
            <span class="block text-sm font-medium text-slate-900">Habilitar directorio de servicios</span>
            <span class="block text-xs text-slate-500">Permite que los miembros aparezcan en un directorio interno de servicios y ocupaciones.</span>
          </span>
        </label>
        <label class="rounded-xl border border-slate-200 p-4 flex items-start gap-3 hover:bg-slate-50 transition-colors cursor-pointer">
          <%= form.check_box :member_work_contact_enabled, class: "mt-0.5 h-4 w-4 rounded text-violet-600 focus:ring-violet-500" %>
          <span>
            <span class="block text-sm font-medium text-slate-900">Permitir contacto laboral entre miembros</span>
            <span class="block text-xs text-slate-500">Cuando esta activo, los miembros pueden contactarse para temas laborales o servicios.</span>
          </span>
        </label>
      </div>
    </section>

    <div class="flex justify-end gap-3">
      <%= link_to "Cancelar", church_path(@church), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <%= form.submit "Guardar configuracion", class: "rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</section>
