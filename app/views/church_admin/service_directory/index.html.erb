<section class="mx-auto w-full max-w-7xl px-6 py-8">

  <%# Header %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Directorio de servicios</h1>
      <p class="mt-1 text-sm text-slate-500">Miembros que ofrecen servicios, habilidades o buscan trabajo.</p>
    </div>
    <span class="mt-1 shrink-0 inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-600">
      <%= @members.size %> <%= @members.size == 1 ? "miembro" : "miembros" %>
    </span>
  </div>

  <%# Filters %>
  <%= form_with url: church_admin_service_directory_path(@church), method: :get, local: true do %>
    <div class="mt-6 flex flex-wrap items-end gap-3 rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-card">
      <div class="min-w-[140px] flex-1">
        <label class="mb-1 block text-xs font-medium text-slate-500">Vista</label>
        <select name="filter" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 focus:border-violet-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500/20">
          <option value="all"              <%= "selected" if @filter == "all" %>>Todos</option>
          <option value="offers"           <%= "selected" if @filter == "offers" %>>Ofrecen servicios</option>
          <option value="skills"           <%= "selected" if @filter == "skills" %>>Ofrecen habilidades</option>
          <option value="looking_for_work" <%= "selected" if @filter == "looking_for_work" %>>Buscando trabajo</option>
        </select>
      </div>
      <div class="min-w-[160px] flex-1">
        <label class="mb-1 block text-xs font-medium text-slate-500">Ocupación</label>
        <%= select_tag :occupation_id, options_for_select([ ["Cualquiera", ""] ] + @occupation_options, params[:occupation_id]),
              class: "w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 focus:border-violet-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>
      <div class="min-w-[160px] flex-1">
        <label class="mb-1 block text-xs font-medium text-slate-500">Habilidad</label>
        <%= select_tag :skill_id, options_for_select([ ["Cualquiera", ""] ] + @skill_options, params[:skill_id]),
              class: "w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700 focus:border-violet-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>
      <button type="submit" class="rounded-lg bg-violet-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-violet-700">Filtrar</button>
    </div>
  <% end %>

  <%# Directory grid %>
  <% if @members.any? %>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @members.each do |member| %>
        <%
          offering_occs   = member.member_occupations.select { |mo| mo.occupation.present? && mo.offers_services }
          looking_occs    = member.member_occupations.select { |mo| mo.occupation.present? && mo.looking_for_work }
          offering_skills = member.member_skills.select { |ms| ms.skill.present? && ms.offers_service }
          has_tags        = offering_occs.any? || offering_skills.any? || looking_occs.any?
          whatsapp_number = member.phone.to_s.gsub(/\D/, "")
        %>
        <%# Estructura: outer flex-col sin padding → content flex-1 → button fijo al fondo %>
        <div class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card transition-shadow hover:shadow-card-hover">

          <%# Contenido — crece para llenar el espacio disponible %>
          <div class="flex flex-1 flex-col items-center p-6 text-center">

            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-violet-100 text-base font-bold text-violet-700">
              <%= member.first_name&.first&.upcase %><%= member.last_name&.first&.upcase %>
            </div>

            <p class="mt-3 font-semibold text-slate-900 leading-snug"><%= member.full_name %></p>

            <div class="mt-2 flex flex-col items-center gap-1.5">
              <% if member.email.present? %>
                <span class="text-xs text-slate-400"><%= member.email %></span>
              <% end %>
              <% if member.phone.present? %>
                <a href="https://wa.me/<%= whatsapp_number %>"
                   target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1 text-xs font-medium text-emerald-600 transition-colors hover:text-emerald-700">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                  </svg>
                  <%= member.phone %>
                </a>
              <% end %>
            </div>

            <%# Tags %>
            <% if has_tags %>
              <div class="mt-4 w-full border-t border-slate-100 pt-4 flex flex-wrap justify-center gap-1.5">
                <% offering_occs.each do |mo| %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-medium text-sky-700 ring-1 ring-inset ring-sky-200">
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM1.49 15.326a.78.78 0 0 1-.358-.442 3 3 0 0 1 4.308-3.516 6.484 6.484 0 0 0-1.905 3.959c-.023.222-.014.442.025.654a4.97 4.97 0 0 1-2.07-.655ZM16.44 15.98a4.97 4.97 0 0 0 2.07-.654.78.78 0 0 0 .357-.442 3 3 0 0 0-4.308-3.517 6.484 6.484 0 0 1 1.907 3.96 2.32 2.32 0 0 1-.026.654ZM18 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM5.304 16.19a.844.844 0 0 1-.277-.71 5 5 0 0 1 9.947 0 .843.843 0 0 1-.277.71A6.975 6.975 0 0 1 10 18a6.974 6.974 0 0 1-4.696-1.81Z" />
                    </svg>
                    <%= mo.occupation.name %>
                  </span>
                <% end %>
                <% offering_skills.each do |ms| %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-violet-50 px-2.5 py-0.5 text-xs font-medium text-violet-700 ring-1 ring-inset ring-violet-200">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63" />
                    </svg>
                    <%= ms.skill.name %>
                    <span class="opacity-60">· <%= skill_level_label(ms.level) %></span>
                  </span>
                <% end %>
                <% looking_occs.each do |mo| %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-200">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                    Busca trabajo · <%= mo.occupation.name %>
                  </span>
                <% end %>
              </div>
            <% end %>

          </div>

          <%# Ver perfil — elemento separado FUERA del área flex-1, siempre al fondo %>
          <div class="border-t border-slate-100 px-6 py-4">
            <%= link_to "Ver perfil", church_admin_member_path(@church, member),
                  class: "block w-full rounded-lg border border-slate-200 py-2 text-center text-xs font-semibold text-slate-600 transition-all hover:border-violet-300 hover:bg-violet-50 hover:text-violet-700" %>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div class="mt-4 flex flex-col items-center rounded-xl border border-slate-200 bg-white py-16 text-center shadow-card">
      <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
        <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
        </svg>
      </div>
      <p class="mt-3 text-sm font-medium text-slate-700">Sin resultados</p>
      <p class="mt-1 text-xs text-slate-400">No hay miembros con los filtros seleccionados.</p>
    </div>
  <% end %>

</section>
