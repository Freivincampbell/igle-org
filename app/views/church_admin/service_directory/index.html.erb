<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900">Directorio de servicios</h1>
    <p class="mt-1 text-sm text-slate-500">Miembros que ofrecen servicios, habilidades o buscan trabajo.</p>
  </div>

  <%= form_with url: church_admin_service_directory_path(@church), method: :get, local: true, class: "mt-6 flex flex-wrap items-end gap-3" do %>
    <div>
      <label class="block text-xs font-medium text-slate-500">Vista</label>
      <select name="filter" class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20">
        <option value="all"              <%= "selected" if @filter == "all" %>>Todos</option>
        <option value="offers"           <%= "selected" if @filter == "offers" %>>Ofrecen servicios</option>
        <option value="skills"           <%= "selected" if @filter == "skills" %>>Ofrecen habilidades</option>
        <option value="looking_for_work" <%= "selected" if @filter == "looking_for_work" %>>Buscando trabajo</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-slate-500">Ocupación</label>
      <%= select_tag :occupation_id, options_for_select([ ["Cualquiera", ""] ] + @occupation_options, params[:occupation_id]),
            class: "mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-slate-500">Habilidad</label>
      <%= select_tag :skill_id, options_for_select([ ["Cualquiera", ""] ] + @skill_options, params[:skill_id]),
            class: "mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
    </div>
    <button type="submit" class="rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors">Filtrar</button>
  <% end %>

  <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <% if @members.any? %>
      <ul class="divide-y divide-slate-100">
        <% @members.each do |member| %>
          <%
            offering_occs   = member.member_occupations.select { |mo| mo.occupation.present? && mo.offers_services }
            looking_occs    = member.member_occupations.select { |mo| mo.occupation.present? && mo.looking_for_work }
            offering_skills = member.member_skills.select { |ms| ms.skill.present? && ms.offers_service }
          %>
          <li class="flex items-start gap-4 px-5 py-4 hover:bg-slate-50/60 transition-colors">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-violet-100 text-sm font-bold text-violet-700">
              <%= member.first_name&.first&.upcase %><%= member.last_name&.first&.upcase %>
            </div>

            <div class="min-w-0 flex-1">
              <p class="font-semibold text-slate-900"><%= member.full_name %></p>

              <%# Ocupaciones con servicio %>
              <% if offering_occs.any? %>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                  <% offering_occs.each do |mo| %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-medium text-sky-700 ring-1 ring-sky-200">
                      <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM1.49 15.326a.78.78 0 0 1-.358-.442 3 3 0 0 1 4.308-3.516 6.484 6.484 0 0 0-1.905 3.959c-.023.222-.014.442.025.654a4.97 4.97 0 0 1-2.07-.655ZM16.44 15.98a4.97 4.97 0 0 0 2.07-.654.78.78 0 0 0 .357-.442 3 3 0 0 0-4.308-3.517 6.484 6.484 0 0 1 1.907 3.96 2.32 2.32 0 0 1-.026.654ZM18 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM5.304 16.19a.844.844 0 0 1-.277-.71 5 5 0 0 1 9.947 0 .843.843 0 0 1-.277.71A6.975 6.975 0 0 1 10 18a6.974 6.974 0 0 1-4.696-1.81Z" />
                      </svg>
                      <%= mo.occupation.name %>
                    </span>
                  <% end %>
                </div>
              <% end %>

              <%# Habilidades con servicio %>
              <% if offering_skills.any? %>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                  <% offering_skills.each do |ms| %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-violet-50 px-2.5 py-0.5 text-xs font-medium text-violet-700 ring-1 ring-violet-200">
                      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63" />
                      </svg>
                      <%= ms.skill.name %>
                      <span class="text-[10px] opacity-70">(<%= skill_level_label(ms.level) %>)</span>
                    </span>
                  <% end %>
                </div>
              <% end %>

              <%# Busca trabajo %>
              <% if looking_occs.any? %>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                  <% looking_occs.each do |mo| %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-amber-200">
                      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                      </svg>
                      Busca trabajo · <%= mo.occupation.name %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="shrink-0 text-right">
              <% contact = member.email.presence || member.phone.presence %>
              <% if contact %>
                <p class="text-xs text-slate-500"><%= contact %></p>
              <% end %>
              <%= link_to "Ver perfil", church_admin_member_path(@church, member),
                    class: "mt-1 inline-block text-xs font-medium text-violet-600 hover:text-violet-700 transition-colors" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="flex flex-col items-center py-12 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
          <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
          </svg>
        </div>
        <p class="mt-3 text-sm text-slate-500">No hay registros en el directorio con los filtros seleccionados.</p>
      </div>
    <% end %>
  </div>
</section>
