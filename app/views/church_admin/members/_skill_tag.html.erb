<%# locals: (name:, level: "basic", offers_service: false, idx: nil, always_show_remove: false) %>
<%
  level_opts = MemberSkill::LEVELS.map { |l| [skill_level_label(l), l] }
  field_idx  = idx || "__IDX__"
%>
<div data-catalog-tag class="group/row py-2.5 first:pt-0 last:pb-0 animate-fade-in-up">

  <%# Fila 1: ícono + nombre + quitar %>
  <div class="flex items-center gap-2">
    <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
      </svg>
    </div>

    <span data-tag-name class="min-w-0 flex-1 truncate text-sm font-semibold text-slate-900"><%= name %></span>

    <input type="hidden" data-tag-name-input name="skills[][name]" value="<%= name %>">
    <input type="hidden" data-tag-idx-input name="_skill_idx" value="<%= field_idx %>">

    <% if always_show_remove %>
      <button type="button" data-action="catalog-search#removeTag"
              class="shrink-0 rounded-md p-1 text-slate-300 transition-all hover:bg-rose-50 hover:text-rose-500">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    <% end %>
  </div>

  <%# Fila 2: nivel + ofrece servicio %>
  <div class="mt-1.5 flex items-center gap-2 pl-9">
    <select data-tag-level name="skills[][level]"
            data-action="change->catalog-search#flagChanged"
            class="rounded-lg border border-slate-200 bg-slate-50 py-0.5 pl-2 pr-6 text-xs font-medium text-slate-600 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-200 transition-colors">
      <% level_opts.each do |label, val| %>
        <option value="<%= val %>" <%= "selected" if val == level %>><%= label %></option>
      <% end %>
    </select>

    <label class="flex cursor-pointer items-center gap-1 rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-medium text-slate-500 transition-colors hover:border-sky-300 hover:text-sky-600 has-[:checked]:border-sky-400 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700">
      <input type="checkbox" name="skills[][offers_service]" value="1" <%= "checked" if offers_service %>
             data-action="change->catalog-search#flagChanged" class="sr-only">
      <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM1.49 15.326a.78.78 0 0 1-.358-.442 3 3 0 0 1 4.308-3.516 6.484 6.484 0 0 0-1.905 3.959c-.023.222-.014.442.025.654a4.97 4.97 0 0 1-2.07-.655ZM16.44 15.98a4.97 4.97 0 0 0 2.07-.654.78.78 0 0 0 .357-.442 3 3 0 0 0-4.308-3.517 6.484 6.484 0 0 1 1.907 3.96 2.32 2.32 0 0 1-.026.654ZM18 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM5.304 16.19a.844.844 0 0 1-.277-.71 5 5 0 0 1 9.947 0 .843.843 0 0 1-.277.71A6.975 6.975 0 0 1 10 18a6.974 6.974 0 0 1-4.696-1.81Z" />
      </svg>
      Ofrece servicio
    </label>
  </div>
</div>
