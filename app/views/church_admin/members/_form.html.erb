<%= form_with model: [ @church, :admin, member ], class: "mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-card" do |form| %>
  <% if member.errors.any? %>
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <p class="font-medium">No se pudo guardar el miembro.</p>
      <ul class="mt-2 list-disc pl-5">
        <% member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="mb-6">
    <h2 class="text-base font-semibold text-slate-900">Foto</h2>
    <div class="mt-4 flex items-center gap-6">
      <% if member.photo.attached? %>
        <%= image_tag member.photo.variant(resize_to_fill: [96, 96]).processed,
              class: "h-24 w-24 rounded-full object-cover border border-slate-200" %>
      <% else %>
        <div class="flex h-24 w-24 items-center justify-center rounded-full bg-violet-100 text-violet-700 text-3xl font-semibold">
          <%= member.first_name&.first&.upcase %>
        </div>
      <% end %>
      <div>
        <%= form.label :photo, "Foto de perfil", class: "block text-sm font-medium text-slate-700" %>
        <%= form.file_field :photo, accept: "image/*", class: "mt-2 block text-sm text-slate-600 file:mr-4 file:rounded-md file:border-0 file:bg-violet-600 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-white hover:file:bg-violet-700 file:cursor-pointer file:transition-colors" %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-base font-semibold text-slate-900">Datos personales</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :first_name, "Nombre", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :first_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :middle_name, "Segundo nombre", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :middle_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :last_name, "Apellido", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :last_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :second_last_name, "Segundo apellido", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :second_last_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :birth_date, "Fecha de nacimiento", class: "block text-sm font-medium text-slate-700" %>
        <%= form.date_field :birth_date, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :gender, "Genero", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :gender, Member.genders.keys.map { |gender| [ member_gender_label(gender), gender ] }, { include_blank: "Seleccionar" }, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :marital_status, "Estado civil", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :marital_status, Member.marital_statuses.keys.map { |status| [ member_marital_status_label(status), status ] }, { include_blank: "Seleccionar" }, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :children_count, "Numero de hijos", class: "block text-sm font-medium text-slate-700" %>
        <%= form.number_field :children_count, min: 0, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>
    </div>
  </section>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-base font-semibold text-slate-900">Contacto y acceso</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :phone, "Telefono", class: "block text-sm font-medium text-slate-700" %>
        <%= form.telephone_field :phone, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :secondary_phone, "Telefono secundario", class: "block text-sm font-medium text-slate-700" %>
        <%= form.telephone_field :secondary_phone, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :email, "Email", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :user_id, "Usuario de acceso", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :user_id, @user_options, { include_blank: "Sin usuario vinculado" }, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>
    </div>
  </section>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-base font-semibold text-slate-900">Direccion</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :address_line_1, "Direccion", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :address_line_1, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :address_line_2, "Detalle adicional", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :address_line_2, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :city, "Ciudad", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :city, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :state, "Provincia/Estado", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :state, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :postal_code, "Codigo postal", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :postal_code, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :country, "Pais", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :country, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>
    </div>
  </section>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-base font-semibold text-slate-900">Iglesia</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :baptized_on, "Fecha de bautismo", class: "block text-sm font-medium text-slate-700" %>
        <%= form.date_field :baptized_on, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :official_membership_on, "Fecha de membresia oficial", class: "block text-sm font-medium text-slate-700" %>
        <%= form.date_field :official_membership_on, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :member_status, "Estado", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :member_status, Member.member_statuses.keys.map { |status| [ member_status_label(status), status ] }, {}, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>
    </div>
  </section>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-base font-semibold text-slate-900">Emergencia y notas</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :emergency_contact_name, "Contacto de emergencia", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :emergency_contact_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div>
        <%= form.label :emergency_contact_phone, "Telefono de emergencia", class: "block text-sm font-medium text-slate-700" %>
        <%= form.telephone_field :emergency_contact_phone, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :notes, "Notas administrativas", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :notes, rows: 4, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
      </div>
    </div>
  </section>

  <%# ── Ocupaciones y habilidades ── %>
  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-base font-semibold text-slate-900">Ocupaciones y habilidades</h2>
    <p class="mt-1 text-sm text-slate-500">Busca o crea desde el catálogo de la iglesia. Se crean automáticamente si no existen.</p>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">

      <%# Ocupaciones %>
      <div>
        <p class="text-sm font-medium text-slate-700">Ocupaciones</p>
        <div class="mt-2 rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden"
             data-controller="catalog-search"
             data-catalog-search-url-value="<%= search_church_admin_occupations_path(@church) %>"
             data-catalog-search-suffix-value="form-occ"
             data-catalog-search-auto-save-value="false">
              <input type="hidden" name="occupation_section_submitted" value="1">

          <div class="border-b border-slate-100 px-3 py-2">
            <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 focus-within:border-violet-400 focus-within:bg-white focus-within:ring-2 focus-within:ring-violet-200 transition-colors">
              <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
              <input type="text" placeholder="Buscar o crear..."
                     autocomplete="off"
                     data-catalog-search-target="input"
                     data-action="input->catalog-search#search keydown->catalog-search#keydown"
                     class="w-full bg-transparent py-1.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none">
            </div>
            <div class="relative">
              <turbo-frame id="occupation-results-form-occ"
                           data-catalog-search-target="results"
                           class="absolute left-0 right-0 z-20 mt-1 block max-h-48 overflow-auto rounded-xl border border-slate-200 bg-white shadow-card empty:hidden">
              </turbo-frame>
            </div>
          </div>

          <div class="px-3 py-2">
            <div data-catalog-search-target="emptyState"
                 class="<%= defined?(@form_occupations) && @form_occupations&.any? ? 'hidden' : '' %> py-3 text-center">
              <p class="text-xs text-slate-400">Sin ocupaciones aún</p>
            </div>
            <div data-catalog-search-target="tagsZone" class="divide-y divide-slate-50">
              <% Array(@form_occupations).each do |mo| %>
                <%= render "church_admin/members/occupation_tag",
                      name: mo.occupation.name,
                      offers_services: mo.offers_services,
                      looking_for_work: mo.looking_for_work,
                      always_show_remove: true %>
              <% end %>
            </div>
          </div>

          <template data-catalog-search-target="template">
            <%= render "church_admin/members/occupation_tag",
                  name: "", offers_services: false, looking_for_work: false,
                  always_show_remove: true %>
          </template>
        </div>
      </div>

      <%# Habilidades %>
      <div>
        <p class="text-sm font-medium text-slate-700">Habilidades</p>
        <div class="mt-2 rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden"
             data-controller="catalog-search"
             data-catalog-search-url-value="<%= search_church_admin_skills_path(@church) %>"
             data-catalog-search-suffix-value="form-sk"
             data-catalog-search-auto-save-value="false">
              <input type="hidden" name="skill_section_submitted" value="1">

          <div class="border-b border-slate-100 px-3 py-2">
            <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 focus-within:border-violet-400 focus-within:bg-white focus-within:ring-2 focus-within:ring-violet-200 transition-colors">
              <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
              <input type="text" placeholder="Buscar o crear..."
                     autocomplete="off"
                     data-catalog-search-target="input"
                     data-action="input->catalog-search#search keydown->catalog-search#keydown"
                     class="w-full bg-transparent py-1.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none">
            </div>
            <div class="relative">
              <turbo-frame id="skill-results-form-sk"
                           data-catalog-search-target="results"
                           class="absolute left-0 right-0 z-20 mt-1 block max-h-48 overflow-auto rounded-xl border border-slate-200 bg-white shadow-card empty:hidden">
              </turbo-frame>
            </div>
          </div>

          <div class="px-3 py-2">
            <div data-catalog-search-target="emptyState"
                 class="<%= defined?(@form_skills) && @form_skills&.any? ? 'hidden' : '' %> py-3 text-center">
              <p class="text-xs text-slate-400">Sin habilidades aún</p>
            </div>
            <div data-catalog-search-target="tagsZone" class="divide-y divide-slate-50">
              <% Array(@form_skills).each_with_index do |ms, i| %>
                <%= render "church_admin/members/skill_tag",
                      name: ms.skill.name,
                      level: ms.level,
                      offers_service: ms.offers_service,
                      idx: i,
                      always_show_remove: true %>
              <% end %>
            </div>
          </div>

          <template data-catalog-search-target="template">
            <%= render "church_admin/members/skill_tag",
                  name: "", level: "basic", idx: nil,
                  always_show_remove: true %>
          </template>
        </div>
      </div>

    </div>
  </section>

  <%# ── Ministerios ── %>
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <h2 class="text-base font-semibold text-slate-900">Ministerios</h2>
    <p class="mt-1 text-sm text-slate-500">Asigna el miembro a ministerios de la iglesia.</p>

    <input type="hidden" name="ministry_memberships_submitted" value="1">

    <div class="mt-4"
         data-controller="ministry-picker"
         data-ministry-picker-url-value="<%= search_church_admin_ministries_path(@church) %>"
         data-ministry-picker-auto-save-value="false">

      <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 focus-within:border-violet-400 focus-within:bg-white focus-within:ring-2 focus-within:ring-violet-200 transition-colors">
        <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <input type="text"
               placeholder="Buscar ministerio..."
               autocomplete="off"
               data-ministry-picker-target="input"
               data-action="input->ministry-picker#search keydown->ministry-picker#keydown"
               class="w-full bg-transparent py-1.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none">
      </div>
      <div class="relative">
        <turbo-frame id="ministry-results-form"
                     data-ministry-picker-target="results"
                     class="absolute left-0 right-0 z-20 mt-1 block max-h-48 overflow-auto rounded-xl border border-slate-200 bg-white shadow-card empty:hidden">
        </turbo-frame>
      </div>

      <div class="mt-3">
        <div data-ministry-picker-target="emptyState"
             class="<%= defined?(@form_ministries) && @form_ministries&.any? ? 'hidden' : '' %> py-3 text-center">
          <p class="text-xs text-slate-400">Sin ministerios asignados.</p>
        </div>
        <div data-ministry-picker-target="tagsZone" class="divide-y divide-slate-50">
          <% Array(@form_ministries).each do |mm| %>
            <%= render "church_admin/members/ministry_tag",
                  name: mm.ministry.name,
                  role: mm.ministry_role,
                  ministry_public_id: mm.ministry.public_id,
                  always_show_remove: true %>
          <% end %>
        </div>
      </div>

      <template data-ministry-picker-target="template">
        <%= render "church_admin/members/ministry_tag",
              name: "",
              role: "member",
              ministry_public_id: nil,
              always_show_remove: true %>
      </template>
    </div>
  </section>

  <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-6">
    <%= link_to "Cancelar", member.persisted? ? church_admin_member_path(@church, member) : church_admin_members_path(@church), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
    <%= form.submit "Guardar", class: "rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
