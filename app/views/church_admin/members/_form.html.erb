<%= form_with model: [ @church, :admin, member ], class: "mt-8 rounded-lg border border-slate-200 bg-white p-6" do |form| %>
  <% if member.errors.any? %>
    <div class="mb-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-medium">No se pudo guardar el miembro.</p>
      <ul class="mt-2 list-disc pl-5">
        <% member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section>
    <h2 class="text-lg font-semibold text-slate-950">Datos personales</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :first_name, "Nombre", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :first_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :middle_name, "Segundo nombre", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :middle_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :last_name, "Apellido", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :last_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :second_last_name, "Segundo apellido", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :second_last_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :birth_date, "Fecha de nacimiento", class: "block text-sm font-medium text-slate-700" %>
        <%= form.date_field :birth_date, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :gender, "Genero", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :gender, Member.genders.keys.map { |gender| [ member_gender_label(gender), gender ] }, { include_blank: "Seleccionar" }, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :marital_status, "Estado civil", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :marital_status, Member.marital_statuses.keys.map { |status| [ member_marital_status_label(status), status ] }, { include_blank: "Seleccionar" }, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :children_count, "Numero de hijos", class: "block text-sm font-medium text-slate-700" %>
        <%= form.number_field :children_count, min: 0, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>
    </div>
  </section>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-lg font-semibold text-slate-950">Contacto y acceso</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :phone, "Telefono", class: "block text-sm font-medium text-slate-700" %>
        <%= form.telephone_field :phone, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :secondary_phone, "Telefono secundario", class: "block text-sm font-medium text-slate-700" %>
        <%= form.telephone_field :secondary_phone, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :email, "Email", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :user_id, "Usuario de acceso", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :user_id, @user_options, { include_blank: "Sin usuario vinculado" }, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>
    </div>
  </section>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-lg font-semibold text-slate-950">Direccion</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :address_line_1, "Direccion", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :address_line_1, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :address_line_2, "Detalle adicional", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :address_line_2, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :city, "Ciudad", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :city, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :state, "Provincia/Estado", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :state, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :postal_code, "Codigo postal", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :postal_code, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :country, "Pais", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :country, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>
    </div>
  </section>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-lg font-semibold text-slate-950">Iglesia</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :baptized_on, "Fecha de bautismo", class: "block text-sm font-medium text-slate-700" %>
        <%= form.date_field :baptized_on, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :official_membership_on, "Fecha de membresia oficial", class: "block text-sm font-medium text-slate-700" %>
        <%= form.date_field :official_membership_on, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :member_status, "Estado", class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :member_status, Member.member_statuses.keys.map { |status| [ member_status_label(status), status ] }, {}, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>
    </div>
  </section>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-lg font-semibold text-slate-950">Emergencia y notas</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :emergency_contact_name, "Contacto de emergencia", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :emergency_contact_name, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div>
        <%= form.label :emergency_contact_phone, "Telefono de emergencia", class: "block text-sm font-medium text-slate-700" %>
        <%= form.telephone_field :emergency_contact_phone, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :notes, "Notas administrativas", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :notes, rows: 4, class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
      </div>
    </div>
  </section>

  <div class="mt-8 flex justify-end gap-3 border-t border-slate-200 pt-6">
    <%= link_to "Cancelar", member.persisted? ? church_admin_member_path(@church, member) : church_admin_members_path(@church), class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    <%= form.submit "Guardar", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
  </div>
<% end %>
