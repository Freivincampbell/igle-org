<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <div class="mt-2 flex items-center gap-6">
        <% if @member.photo.attached? %>
          <%= image_tag @member.photo.variant(resize_to_fill: [88, 88]).processed,
                class: "h-22 w-22 rounded-full object-cover border border-slate-200" %>
        <% else %>
          <div class="flex h-22 w-22 items-center justify-center rounded-full bg-violet-100 text-violet-700 text-2xl font-semibold">
            <%= @member.first_name&.first&.upcase %>
          </div>
        <% end %>
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold text-slate-900"><%= @member.full_name %></h1>
            <% if @member.active? %>
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 border border-emerald-200">Activo</span>
            <% else %>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500 border border-slate-200">Inactivo</span>
            <% end %>
          </div>
          <p class="mt-1 text-sm text-slate-500"><%= @member.public_id %></p>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <% if policy(@member).edit? %>
        <%= link_to "Editar", edit_church_admin_member_path(@church, @member), class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <% end %>
      <% if @member.active? && policy(@member).deactivate? %>
        <%= button_to "Desactivar", deactivate_church_admin_member_path(@church, @member), method: :patch, class: "inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100 transition-colors" %>
      <% elsif @member.inactive? && policy(@member).activate? %>
        <%= button_to "Activar", activate_church_admin_member_path(@church, @member), method: :patch, class: "inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100 transition-colors" %>
      <% end %>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_20rem]">
    <div class="space-y-6">
      <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
        <h2 class="text-base font-semibold text-slate-900">Datos personales</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Fecha de nacimiento</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.birth_date %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Genero</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= member_gender_label(@member.gender) %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Estado civil</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= member_marital_status_label(@member.marital_status) %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Numero de hijos</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.children_count %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
        <h2 class="text-base font-semibold text-slate-900">Contacto</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Telefono</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.phone %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Telefono secundario</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.secondary_phone.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Email</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.email.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Usuario de acceso</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.user&.email || "No vinculado" %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
        <h2 class="text-base font-semibold text-slate-900">Direccion</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Direccion</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.address_line_1.presence || "No definida" %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Detalle adicional</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.address_line_2.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Ciudad</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.city.presence || "No definida" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Pais</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.country.presence || "No definido" %></dd>
          </div>
        </dl>
      </section>
    </div>

    <aside class="space-y-6">
      <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
        <h2 class="text-base font-semibold text-slate-900">Iglesia</h2>
        <dl class="mt-5 space-y-4">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Estado</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= member_status_label(@member.member_status) %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Bautismo</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.baptized_on.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Membresia oficial</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.official_membership_on.presence || "No definida" %></dd>
          </div>
        </dl>
      </section>

      <%# ── Ministerios ── %>
      <section class="rounded-xl border border-slate-200 bg-white shadow-card overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
          <h2 class="text-base font-semibold text-slate-900">Ministerios</h2>
          <% if @ministry_memberships.any? %>
            <span class="rounded-full bg-violet-50 px-2.5 py-0.5 text-xs font-semibold text-violet-700 ring-1 ring-violet-200">
              <%= @ministry_memberships.size %>
            </span>
          <% end %>
        </div>

        <% if @ministry_memberships.any? %>
          <ul class="divide-y divide-slate-50">
            <% @ministry_memberships.each do |mm| %>
              <li class="flex items-center gap-3 px-6 py-3">
                <%# Ícono del ministerio %>
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-violet-50 text-violet-600">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
                  </svg>
                </div>

                <div class="min-w-0 flex-1">
                  <%= link_to mm.ministry.name,
                        church_admin_ministry_path(@church, mm.ministry),
                        class: "block truncate text-sm font-semibold text-slate-900 hover:text-violet-700 transition-colors" %>
                </div>

                <%# Badge de rol %>
                <%
                  role_badge = case mm.ministry_role
                    when "leader"    then "bg-violet-50 text-violet-700 ring-violet-200"
                    when "co_leader" then "bg-sky-50 text-sky-700 ring-sky-200"
                    else                  "bg-slate-100 text-slate-600 ring-slate-200"
                  end
                %>
                <span class="shrink-0 inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold ring-1 <%= role_badge %>">
                  <%= ministry_role_label(mm.ministry_role) %>
                </span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="flex flex-col items-center py-8 text-center">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100">
              <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
              </svg>
            </div>
            <p class="mt-2 text-sm text-slate-500">Sin ministerios asignados</p>
          </div>
        <% end %>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card">
        <h2 class="text-base font-semibold text-slate-900">Emergencia</h2>
        <dl class="mt-5 space-y-4">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Contacto</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.emergency_contact_name.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Telefono</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.emergency_contact_phone.presence || "No definido" %></dd>
          </div>
        </dl>
      </section>
    </aside>
  </div>
</section>
