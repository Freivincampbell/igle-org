<section class="mx-auto w-full max-w-6xl px-6 py-10">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= @church.name %></p>
      <div class="flex items-center gap-6">
        <% if @member.photo.attached? %>
          <%= image_tag @member.photo.variant(resize_to_fill: [80, 80]).processed,
                class: "h-20 w-20 rounded-full object-cover border border-slate-200" %>
        <% else %>
          <div class="flex h-20 w-20 items-center justify-center rounded-full bg-slate-100 text-slate-400 text-2xl font-semibold">
            <%= @member.first_name&.first&.upcase %>
          </div>
        <% end %>
        <div>
          <h1 class="text-3xl font-semibold text-slate-950"><%= @member.full_name %></h1>
          <p class="mt-1 text-sm text-slate-500"><%= @member.public_id %></p>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <% if policy(@member).edit? %>
        <%= link_to "Editar", edit_church_admin_member_path(@church, @member), class: "inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if @member.active? && policy(@member).deactivate? %>
        <%= button_to "Desactivar", deactivate_church_admin_member_path(@church, @member), method: :patch, class: "rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100" %>
      <% elsif @member.inactive? && policy(@member).activate? %>
        <%= button_to "Activar", activate_church_admin_member_path(@church, @member), method: :patch, class: "rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100" %>
      <% end %>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_20rem]">
    <div class="space-y-6">
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-950">Datos personales</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Fecha de nacimiento</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.birth_date %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Genero</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= member_gender_label(@member.gender) %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Estado civil</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= member_marital_status_label(@member.marital_status) %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Numero de hijos</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.children_count %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-950">Contacto</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Telefono</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.phone %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Telefono secundario</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.secondary_phone.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Email</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.email.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Usuario de acceso</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.user&.email || "No vinculado" %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-950">Direccion</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Direccion</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.address_line_1.presence || "No definida" %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Detalle adicional</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.address_line_2.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Ciudad</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.city.presence || "No definida" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Pais</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.country.presence || "No definido" %></dd>
          </div>
        </dl>
      </section>
    </div>

    <aside class="space-y-6">
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-950">Iglesia</h2>
        <dl class="mt-5 space-y-4">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Estado</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= member_status_label(@member.member_status) %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Bautismo</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.baptized_on.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Membresia oficial</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.official_membership_on.presence || "No definida" %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-950">Emergencia</h2>
        <dl class="mt-5 space-y-4">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Contacto</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.emergency_contact_name.presence || "No definido" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Telefono</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @member.emergency_contact_phone.presence || "No definido" %></dd>
          </div>
        </dl>
      </section>
    </aside>
  </div>
</section>
