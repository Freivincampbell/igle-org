<section class="mx-auto w-full max-w-5xl px-6 py-8">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-2 text-2xl font-bold text-slate-900">Editar miembro</h1>
    </div>

    <%= link_to "Ver miembro", church_admin_member_path(@church, @member), class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
  </div>

  <%= render "form", member: @member %>
</section>
