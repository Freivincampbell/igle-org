<section class="mx-auto w-full max-w-7xl px-6 py-8">

  <%# Page header %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1.5 text-2xl font-bold text-slate-900">Miembros</h1>
    </div>
    <% if policy(Member).new? %>
      <%= link_to new_church_admin_member_path(@church),
            class: "inline-flex items-center gap-1.5 self-start rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nuevo miembro
      <% end %>
    <% end %>
  </div>

  <%= render "shared/table_toolbar",
        url: church_admin_members_path(@church),
        frame_id: "table-members",
        label: "miembros",
        q: params[:q],
        filters: [
          { param: :status, label: "Estado",
            options: [["Activo", "active"], ["Inactivo", "inactive"]],
            value: params[:status] }
        ] %>

  <turbo-frame id="table-members" data-turbo-action="advance" target="_top" class="mt-3 block">
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
      <table class="min-w-full divide-y divide-slate-100 text-sm">
        <thead>
          <tr class="bg-slate-50">
            <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Miembro</th>
            <th class="hidden sm:table-cell px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Contacto</th>
            <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</th>
            <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% if @members.any? %>
            <% @members.each do |member| %>
              <tr class="group hover:bg-slate-50/80 transition-colors">
                <td class="px-5 py-3.5">
                  <div class="flex items-center gap-3">
                    <% if member.photo.attached? %>
                      <%= image_tag member.photo.variant(resize_to_fill: [36, 36]).processed,
                            class: "h-9 w-9 rounded-full object-cover ring-2 ring-white shadow-sm shrink-0" %>
                    <% else %>
                      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-violet-100 text-sm font-bold text-violet-700 ring-2 ring-white shadow-sm">
                        <%= member.first_name&.first&.upcase %>
                      </div>
                    <% end %>
                    <div class="min-w-0">
                      <p class="font-semibold text-slate-900 truncate"><%= member.full_name %></p>
                      <p class="mt-0.5 text-xs text-slate-400 truncate hidden sm:block"><%= member.public_id %></p>
                    </div>
                  </div>
                </td>
                <td class="hidden sm:table-cell px-5 py-3.5 text-slate-600">
                  <p class="text-sm"><%= member.phone.presence || "Sin teléfono" %></p>
                  <p class="mt-0.5 text-xs text-slate-400"><%= member.email.presence || "Sin email" %></p>
                </td>
                <td class="px-5 py-3.5">
                  <%
                    status = member.member_status.to_s
                    badge_class = case status
                      when "active"   then "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200"
                      when "inactive" then "bg-slate-100 text-slate-500 ring-1 ring-slate-200"
                      when "visitor"  then "bg-sky-50 text-sky-700 ring-1 ring-sky-200"
                      else                 "bg-slate-100 text-slate-600 ring-1 ring-slate-200"
                    end
                  %>
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold <%= badge_class %>">
                    <%= member_status_label(member.member_status) %>
                  </span>
                </td>
                <td class="px-5 py-3.5">
                  <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <% if policy(member).show? %>
                      <%= link_to church_admin_member_path(@church, member),
                            class: "rounded-md bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" do %>Ver<% end %>
                    <% end %>
                    <% if policy(member).edit? %>
                      <%= link_to edit_church_admin_member_path(@church, member),
                            class: "rounded-md bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" do %>Editar<% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-5 py-16 text-center">
                <div class="flex flex-col items-center gap-3">
                  <div class="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                    </svg>
                  </div>
                  <p class="text-sm font-medium text-slate-500">No hay miembros registrados.</p>
                  <% if policy(Member).new? %>
                    <%= link_to "Agregar el primer miembro", new_church_admin_member_path(@church),
                          class: "mt-1 inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-700 transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/table_pagination", pagy: @pagy %>
    </div>
  </turbo-frame>

</section>
