<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900">Nueva ocupacion de <%= @member.full_name %></h1>
  </div>
  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-card">
    <%= render "form", member_occupation: @member_occupation, url: church_admin_member_occupations_path(@church, @member), method: :post %>
  </div>
</section>
