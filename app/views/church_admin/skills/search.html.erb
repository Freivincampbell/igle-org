<%= turbo_frame_tag @frame_id do %>
  <% if @results.any? || @query.present? %>
    <ul class="divide-y divide-slate-50 py-1">
      <% @results.each do |skill| %>
        <li>
          <button type="button"
                  class="group/r flex w-full items-center gap-3 px-4 py-2.5 text-left hover:bg-violet-50 transition-colors"
                  data-action="click->catalog-search#addItem"
                  data-name="<%= skill.name %>">
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-slate-100 text-slate-600">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
              </svg>
            </div>
            <span class="flex-1 text-sm font-medium text-slate-900"><%= skill.name %></span>
            <span class="shrink-0 rounded-full bg-violet-100 px-2 py-0.5 text-[11px] font-semibold text-violet-700 opacity-0 transition-opacity group-hover/r:opacity-100">
              Agregar
            </span>
          </button>
        </li>
      <% end %>

      <% if @query.present? && !@exact_match %>
        <li>
          <button type="button"
                  class="flex w-full items-center gap-3 px-4 py-2.5 text-left hover:bg-emerald-50 transition-colors"
                  data-action="click->catalog-search#addItem"
                  data-name="<%= @query %>"
                  data-create="true">
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-emerald-100 text-emerald-600">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </div>
            <span class="text-sm text-slate-700">Crear <span class="font-semibold text-emerald-700">«<%= @query %>»</span></span>
          </button>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
