<% if skill.errors.any? %>
  <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
    <ul class="list-inside list-disc space-y-1">
      <% skill.errors.full_messages.each { |m| %><li><%= m %></li><% } %>
    </ul>
  </div>
<% end %>
<%= form_with model: skill, url: url, method: method, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :name, "Nombre", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :description, "Descripcion", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_area :description, rows: 3, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :status, "Estado", class: "block text-sm font-medium text-slate-700" %>
    <%= form.select :status, [ [ "Activa", "active" ], [ "Inactiva", "inactive" ] ], {}, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div class="flex justify-end gap-3">
    <%= link_to "Cancelar", church_admin_skills_path(@church), class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    <%= form.submit "Guardar", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
  </div>
<% end %>
