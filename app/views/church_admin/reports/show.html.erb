<div class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500">Reportes</p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @report.title %></h1>
    </div>
    <% if ReportPolicy.new(current_user, nil).export? %>
      <div class="flex gap-2">
        <%= link_to "CSV", church_admin_report_path(current_church, params[:report], format: :csv, **request.query_parameters),
              class: "inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
        <%= link_to "Excel", church_admin_report_path(current_church, params[:report], format: :xlsx, **request.query_parameters),
              class: "inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead>
          <tr>
            <% @report.columns.each do |col| %>
              <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"><%= col[:label] %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% @rows.each do |row| %>
            <tr class="group hover:bg-slate-50/80 transition-colors">
              <% @report.columns.each do |col| %>
                <td class="px-5 py-3 text-slate-700"><%= row[col[:key]] %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @rows.empty? %>
      <p class="px-5 py-8 text-center text-slate-500">Sin datos para los filtros seleccionados.</p>
    <% end %>
  </div>
</div>
