<section class="mx-auto w-full max-w-5xl px-6 py-10">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= @church.name %> / <%= event_type_label(@event.event_type) %></p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-950"><%= @event.title %></h1>
      <p class="mt-1 text-sm text-slate-500">Estado: <%= event_status_label(@event.status) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if policy(@event).edit? %>
        <%= link_to "Editar", edit_church_admin_event_path(@church, @event), class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if policy(@event).update? %>
        <%= link_to "Asistencia", attendance_church_admin_event_path(@church, @event), class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if @event.scheduled? && policy(@event).deactivate? %>
        <%= button_to "Cancelar evento", cancel_church_admin_event_path(@church, @event), method: :patch, form_class: "inline-flex", class: "rounded-md border border-red-300 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-100" %>
      <% elsif @event.cancelled? && policy(@event).activate? %>
        <%= button_to "Reprogramar", reschedule_church_admin_event_path(@church, @event), method: :patch, form_class: "inline-flex", class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-sm font-semibold uppercase text-slate-500">Detalles</h2>
      <dl class="mt-3 space-y-2 text-sm">
        <div><dt class="font-medium text-slate-500">Inicio</dt><dd><%= l(@event.starts_at, format: :default) %></dd></div>
        <% if @event.ends_at %><div><dt class="font-medium text-slate-500">Fin</dt><dd><%= l(@event.ends_at, format: :default) %></dd></div><% end %>
        <% if @event.location.present? %><div><dt class="font-medium text-slate-500">Lugar</dt><dd><%= @event.location %></dd></div><% end %>
        <div><dt class="font-medium text-slate-500">Visibilidad</dt><dd><%= event_visibility_label(@event.visibility) %></dd></div>
        <% if @event.ministry %><div><dt class="font-medium text-slate-500">Ministerio</dt><dd><%= @event.ministry.name %></dd></div><% end %>
        <% if @event.responsible_member %><div><dt class="font-medium text-slate-500">Responsable</dt><dd><%= @event.responsible_member.full_name %></dd></div><% end %>
        <% if @event.capacity %><div><dt class="font-medium text-slate-500">Capacidad</dt><dd><%= @event.capacity %></dd></div><% end %>
        <% if @event.recurring? %><div><dt class="font-medium text-slate-500">Recurrencia</dt><dd><%= event_recurrence_label(@event.recurrence_frequency) %><% if @event.recurrence_until %> hasta <%= l(@event.recurrence_until) %><% end %></dd></div><% end %>
      </dl>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-sm font-semibold uppercase text-slate-500">Confirmaciones</h2>
      <p class="mt-2 text-3xl font-semibold text-slate-950"><%= @event.confirmed_attendees_count %></p>
      <p class="text-xs text-slate-500">Asistentes esperados</p>
      <ul class="mt-4 space-y-1 text-sm text-slate-600">
        <% @rsvps.each do |rsvp| %>
          <li><%= rsvp.member.full_name %> — <%= rsvp.status %></li>
        <% end %>
      </ul>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-sm font-semibold uppercase text-slate-500">Asistencia real</h2>
      <p class="mt-2 text-3xl font-semibold text-slate-950"><%= @event.attended_count %></p>
      <p class="text-xs text-slate-500">Miembros marcados como asistidos</p>
    </div>
  </div>

  <% if @event.description.present? %>
    <div class="mt-8 rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-sm font-semibold uppercase text-slate-500">Descripcion</h2>
      <p class="mt-3 whitespace-pre-line text-sm text-slate-700"><%= @event.description %></p>
    </div>
  <% end %>
</section>
