<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Eventos</h1>
    </div>

    <% if policy(Event).new? %>
      <%= link_to "Nuevo evento", new_church_admin_event_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" %>
    <% end %>
  </div>

  <div class="mt-6 flex gap-2 text-sm">
    <% %w[upcoming past all].each do |filter| %>
      <% label = { "upcoming" => "Proximos", "past" => "Pasados", "all" => "Todos" }[filter] %>
      <%= link_to label, church_admin_events_path(@church, filter:, q: params[:q]),
            class: "rounded-md border px-3 py-2 font-medium #{@filter == filter ? 'border-violet-600 bg-violet-600 text-white' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50'}" %>
    <% end %>
  </div>

  <%= render "shared/table_toolbar",
        url: church_admin_events_path(@church, filter: @filter),
        frame_id: "table-events",
        label: "eventos",
        q: params[:q],
        filters: [] %>
  <turbo-frame id="table-events" data-turbo-action="advance" target="_top" class="mt-3 block">
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead>
        <tr>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Titulo</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Tipo</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Inicio</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Visibilidad</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</th>
          <th class="bg-slate-50 px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @events.any? %>
          <% @events.each do |event| %>
            <tr class="group hover:bg-slate-50/80 transition-colors">
              <td class="px-5 py-4">
                <div class="font-medium text-slate-900"><%= event.title %></div>
                <% if event.ministry %>
                  <div class="text-xs text-slate-500"><%= event.ministry.name %></div>
                <% end %>
              </td>
              <td class="px-5 py-4 text-slate-600"><%= event_type_label(event.event_type) %></td>
              <td class="px-5 py-4 text-slate-600"><%= l(event.starts_at, format: :default) %></td>
              <td class="px-5 py-4 text-slate-600"><%= event_visibility_label(event.visibility) %></td>
              <td class="px-5 py-4 text-slate-600"><%= event_status_label(event.status) %></td>
              <td class="px-5 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <% if policy(event).show? %>
                    <%= link_to "Ver", church_admin_event_path(@church, event), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                  <% if policy(event).edit? %>
                    <%= link_to "Editar", edit_church_admin_event_path(@church, event), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="px-5 py-8 text-center text-slate-500">No hay eventos registrados.</td></tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/table_pagination", pagy: @pagy %>
  </div>
  </turbo-frame>
</section>
