<section class="mx-auto w-full max-w-6xl px-6 py-10">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= @church.name %></p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-950">Eventos</h1>
    </div>

    <% if policy(Event).new? %>
      <%= link_to "Nuevo evento", new_church_admin_event_path(@church), class: "inline-flex items-center justify-center rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
    <% end %>
  </div>

  <div class="mt-6 flex gap-2 text-sm">
    <% %w[upcoming past all].each do |filter| %>
      <% label = { "upcoming" => "Proximos", "past" => "Pasados", "all" => "Todos" }[filter] %>
      <%= link_to label, church_admin_events_path(@church, filter:), class: "rounded-md border px-3 py-2 font-medium #{@filter == filter ? 'border-slate-950 bg-slate-950 text-white' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50'}" %>
    <% end %>
  </div>

  <div class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500">
        <tr>
          <th class="px-4 py-3">Titulo</th>
          <th class="px-4 py-3">Tipo</th>
          <th class="px-4 py-3">Inicio</th>
          <th class="px-4 py-3">Visibilidad</th>
          <th class="px-4 py-3">Estado</th>
          <th class="px-4 py-3 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @events.any? %>
          <% @events.each do |event| %>
            <tr>
              <td class="px-4 py-4">
                <div class="font-medium text-slate-950"><%= event.title %></div>
                <% if event.ministry %>
                  <div class="text-xs text-slate-500"><%= event.ministry.name %></div>
                <% end %>
              </td>
              <td class="px-4 py-4 text-slate-600"><%= event_type_label(event.event_type) %></td>
              <td class="px-4 py-4 text-slate-600"><%= l(event.starts_at, format: :default) %></td>
              <td class="px-4 py-4 text-slate-600"><%= event_visibility_label(event.visibility) %></td>
              <td class="px-4 py-4 text-slate-600"><%= event_status_label(event.status) %></td>
              <td class="px-4 py-4 text-right">
                <div class="flex justify-end gap-3">
                  <% if policy(event).show? %>
                    <%= link_to "Ver", church_admin_event_path(@church, event), class: "font-medium text-slate-600 hover:text-slate-950" %>
                  <% end %>
                  <% if policy(event).edit? %>
                    <%= link_to "Editar", edit_church_admin_event_path(@church, event), class: "font-medium text-slate-600 hover:text-slate-950" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="px-4 py-8 text-center text-slate-500">No hay eventos registrados.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
