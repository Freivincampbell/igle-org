<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">Ministerios</h1>
    </div>

    <% if policy(Ministry).new? %>
      <%= link_to new_church_admin_ministry_path(@church), class: "inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        Nuevo ministerio
      <% end %>
    <% end %>
  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead>
        <tr>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Nombre</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Miembros</th>
          <th class="bg-slate-50 px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</th>
          <th class="bg-slate-50 px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if @ministries.any? %>
          <% @ministries.each do |ministry| %>
            <tr class="group hover:bg-slate-50 transition-colors">
              <td class="px-5 py-4">
                <div class="font-medium text-slate-900"><%= ministry.name %></div>
                <div class="mt-0.5 text-xs text-slate-400"><%= ministry.public_id %></div>
              </td>
              <td class="px-5 py-4 text-slate-600"><%= ministry.ministry_memberships.active.count %></td>
              <td class="px-5 py-4">
                <% if ministry.active? %>
                  <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><%= ministry_status_label(ministry.status) %></span>
                <% else %>
                  <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-slate-200"><%= ministry_status_label(ministry.status) %></span>
                <% end %>
              </td>
              <td class="px-5 py-4 text-right">
                <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                  <% if policy(ministry).show? %>
                    <%= link_to "Ver", church_admin_ministry_path(@church, ministry), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                  <% if policy(ministry).edit? %>
                    <%= link_to "Editar", edit_church_admin_ministry_path(@church, ministry), class: "rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-5 py-8 text-center text-slate-500">No hay ministerios registrados.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
