<section class="mx-auto w-full max-w-7xl px-6 py-8">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-500"><%= @church.name %></p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @ministry.name %></h1>
      <p class="mt-1 text-xs text-slate-400 font-mono"><%= @ministry.public_id %></p>
    </div>

    <div class="flex flex-wrap gap-3">
      <% if policy(@ministry).edit? %>
        <%= link_to "Editar", edit_church_admin_ministry_path(@church, @ministry), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" %>
      <% end %>
      <% if @ministry.active? && policy(@ministry).deactivate? %>
        <%= button_to "Desactivar", deactivate_church_admin_ministry_path(@church, @ministry), method: :patch, class: "rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100 transition-colors cursor-pointer" %>
      <% elsif @ministry.inactive? && policy(@ministry).activate? %>
        <%= button_to "Activar", activate_church_admin_ministry_path(@church, @ministry), method: :patch, class: "rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <% if @ministry.errors.any? %>
    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <p class="font-medium">No se pudo actualizar el ministerio.</p>
      <ul class="mt-2 list-disc pl-5">
        <% @ministry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_22rem]">

    <%# ── Columna principal: solo detalle ── %>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-card self-start">
      <h2 class="text-base font-semibold text-slate-900">Detalle</h2>
      <dl class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Estado</dt>
          <dd class="mt-1">
            <% if @ministry.active? %>
              <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><%= ministry_status_label(@ministry.status) %></span>
            <% else %>
              <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-slate-200"><%= ministry_status_label(@ministry.status) %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Miembros activos</dt>
          <dd class="mt-1 text-sm font-semibold text-slate-900"><%= @ministry.ministry_memberships.active.count %></dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Descripcion</dt>
          <dd class="mt-1 text-sm text-slate-700"><%= @ministry.description.presence || "No definida" %></dd>
        </div>
      </dl>
    </section>

    <%# ── Sidebar: panel unificado de gestión ── %>
    <aside>
      <div class="rounded-xl border border-slate-200 bg-white shadow-card sticky top-6">

        <%# Header %>
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
          <h2 class="text-sm font-semibold text-slate-900">Gestión de miembros</h2>
          <span class="text-xs font-medium text-slate-400"
                data-member-count>
            <%= @active_ministry_memberships.size %> asignado<%= "s" if @active_ministry_memberships.size != 1 %>
          </span>
        </div>

        <%= form_with url: members_church_admin_ministry_path(@church, @ministry), method: :patch do |form| %>
          <% role_options = MinistryMembership.ministry_roles.keys.map { |r| [ ministry_role_label(r), r ] } %>

          <div data-controller="member-search"
               data-member-search-url-value="<%= search_church_admin_members_path(@church) %>">

            <%# ── Sección 1: Agregar miembro ── %>
            <div class="border-b border-slate-100 px-5 py-4" data-member-search-target="searchArea">
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Agregar miembro</p>
              <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 focus-within:border-violet-400 focus-within:bg-white focus-within:ring-2 focus-within:ring-violet-200 transition-colors">
                <svg class="h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <input type="text" placeholder="Buscar por nombre..."
                       autocomplete="off"
                       data-member-search-target="input"
                       data-action="input->member-search#search keydown->member-search#keydown"
                       class="w-full bg-transparent py-1.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none">
              </div>
              <div class="relative">
                <turbo-frame id="member-results-ministry"
                             data-member-search-target="results"
                             class="absolute left-0 right-0 z-20 mt-1 block max-h-60 overflow-auto rounded-xl border border-slate-200 bg-white shadow-card empty:hidden">
                </turbo-frame>
              </div>
            </div>

            <%# ── Sección 2: Asignados agrupados por rol ── %>
            <%
              grouped_memberships = @active_ministry_memberships.group_by { |_, mm| mm.ministry_role }
              role_groups = [
                { role: "leader",    title: "Líder",      empty: "Sin líder asignado",
                  empty_classes: "rounded-lg border border-dashed border-amber-200 bg-amber-50/50 py-3 text-center text-xs text-amber-600" },
                { role: "co_leader", title: "Co-líderes", empty: "Sin co-líderes",
                  empty_classes: "rounded-lg border border-dashed border-slate-200 py-3 text-center text-xs text-slate-400" },
                { role: "member",    title: "Miembros",   empty: "Aún no hay miembros. Busca uno arriba para añadirlo.",
                  empty_classes: "rounded-lg border border-dashed border-slate-200 py-3 text-center text-xs text-slate-400" }
              ]
            %>
            <div data-member-search-target="tagsZone" class="px-5 py-4">
              <% role_groups.each_with_index do |group, index| %>
                <% rows = grouped_memberships.fetch(group[:role], []) %>
                <div class="<%= 'mt-5' if index.positive? %>">
                  <div class="mb-2 flex items-center justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= group[:title] %></p>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500"
                          data-count-for="<%= group[:role] %>"><%= rows.size %></span>
                  </div>

                  <div data-member-search-target="group"
                       data-role-group="<%= group[:role] %>"
                       class="divide-y divide-slate-50">
                    <% rows.each do |public_id, mm| %>
                      <%= render "church_admin/ministries/member_row",
                            public_id: public_id,
                            name: mm.member.full_name,
                            initials: member_initials(mm.member),
                            avatar_color: member_avatar_color(public_id),
                            ids_field: "ministry[member_public_ids][]",
                            meta_field: "ministry[member_roles][#{public_id}]",
                            meta_options: role_options,
                            meta_selected: mm.ministry_role %>
                    <% end %>
                  </div>

                  <div data-empty-for="<%= group[:role] %>"
                       class="<%= 'hidden' if rows.any? %> <%= group[:empty_classes] %>">
                    <%= group[:empty] %>
                  </div>
                </div>
              <% end %>
            </div>

            <%# Template para clonado JS %>
            <template data-member-search-target="template">
              <%= render "church_admin/ministries/member_row",
                    public_id: "__ID__",
                    name: "",
                    initials: "",
                    avatar_color: "bg-violet-100 text-violet-700",
                    ids_field: "ministry[member_public_ids][]",
                    meta_field: "ministry[member_roles][__ID__]",
                    meta_options: role_options,
                    meta_selected: "member" %>
            </template>

          </div>

          <% if policy(@ministry).edit? %>
            <div class="border-t border-slate-100 px-5 py-4">
              <%= form.submit "Guardar asignación",
                    class: "w-full rounded-lg bg-violet-600 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-violet-700 transition-colors cursor-pointer" %>
            </div>
          <% end %>
        <% end %>

      </div>
    </aside>

  </div>
</section>
