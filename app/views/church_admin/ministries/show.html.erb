<section class="mx-auto w-full max-w-6xl px-6 py-10">
  <%= render "church_admin/shared/nav", church: @church %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= @church.name %></p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-950"><%= @ministry.name %></h1>
      <p class="mt-2 text-sm text-slate-500"><%= @ministry.public_id %></p>
    </div>

    <div class="flex flex-wrap gap-3">
      <% if policy(@ministry).edit? %>
        <%= link_to "Editar", edit_church_admin_ministry_path(@church, @ministry), class: "inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if @ministry.active? && policy(@ministry).deactivate? %>
        <%= button_to "Desactivar", deactivate_church_admin_ministry_path(@church, @ministry), method: :patch, class: "rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100" %>
      <% elsif @ministry.inactive? && policy(@ministry).activate? %>
        <%= button_to "Activar", activate_church_admin_ministry_path(@church, @ministry), method: :patch, class: "rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100" %>
      <% end %>
    </div>
  </div>

  <% if @ministry.errors.any? %>
    <div class="mt-8 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-medium">No se pudo actualizar el ministerio.</p>
      <ul class="mt-2 list-disc pl-5">
        <% @ministry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_20rem]">
    <div class="space-y-6">
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-950">Detalle</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Estado</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= ministry_status_label(@ministry.status) %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Miembros activos</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @ministry.ministry_memberships.active.count %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Descripcion</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @ministry.description.presence || "No definida" %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-lg font-semibold text-slate-950">Miembros asignados</h2>
        </div>

        <div class="mt-5 overflow-hidden rounded-lg border border-slate-200">
          <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500">
              <tr>
                <th class="px-4 py-3">Nombre</th>
                <th class="px-4 py-3">Rol</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% active_memberships = @ministry.active_ministry_memberships.ordered %>
              <% if active_memberships.any? %>
                <% active_memberships.each do |membership| %>
                  <tr>
                    <td class="px-4 py-4 font-medium text-slate-950"><%= membership.member.full_name %></td>
                    <td class="px-4 py-4 text-slate-600"><%= ministry_role_label(membership.ministry_role) %></td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="2" class="px-4 py-8 text-center text-slate-500">No hay miembros asignados.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <aside>
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-950">Asignacion</h2>

        <%= form_with url: members_church_admin_ministry_path(@church, @ministry), method: :patch, class: "mt-5 space-y-4" do |form| %>
          <% if @assignable_members.any? %>
            <% @assignable_members.each do |member| %>
              <% membership = @active_ministry_memberships[member.public_id] %>
              <div class="rounded-md border border-slate-200 p-3">
                <label class="flex items-start gap-3 text-sm font-medium text-slate-900">
                  <%= check_box_tag "ministry[member_public_ids][]", member.public_id, membership.present?, class: "mt-1 h-4 w-4 rounded border-slate-300 text-slate-950 focus:ring-slate-500" %>
                  <span>
                    <span class="block"><%= member.full_name %></span>
                    <span class="mt-1 block text-xs font-normal text-slate-500"><%= member.phone %></span>
                  </span>
                </label>
                <%= select_tag "ministry[member_roles][#{member.public_id}]", options_for_select(MinistryMembership.ministry_roles.keys.map { |role| [ ministry_role_label(role), role ] }, membership&.ministry_role || "member"), class: "mt-3 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-slate-500">No hay miembros activos.</p>
          <% end %>

          <% if policy(@ministry).edit? && @assignable_members.any? %>
            <div class="flex justify-end border-t border-slate-200 pt-4">
              <%= form.submit "Guardar asignacion", class: "rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
            </div>
          <% end %>
        <% end %>
      </section>
    </aside>
  </div>
</section>
