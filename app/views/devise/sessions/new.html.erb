<div class="flex min-h-screen">

  <%# ── Left panel: branding (desktop only) ── %>
  <div class="hidden lg:flex w-[420px] shrink-0 flex-col justify-between bg-violet-700 px-10 py-12 text-white"
       style="background: linear-gradient(160deg, #6d28d9 0%, #7c3aed 50%, #8b5cf6 100%);">
    <div>
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
          <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12 11.204 3.045c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <span class="text-lg font-bold tracking-tight">igle<span class="text-violet-300">·org</span></span>
      </div>

      <div class="mt-16">
        <h2 class="text-3xl font-bold leading-tight text-white">
          Gestión integral<br>para tu iglesia
        </h2>
        <p class="mt-4 text-base leading-relaxed text-violet-200">
          Miembros, ministerios, eventos, permisos y reportes en un solo lugar. Simple, seguro y multi-iglesia.
        </p>
      </div>

      <div class="mt-12 space-y-4">
        <% [
          ["Miembros y familias organizados",    "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"],
          ["Roles y permisos dinámicos",          "M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"],
          ["Eventos y asistencia en tiempo real", "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"],
        ].each do |feat, icon_path| %>
          <div class="flex items-center gap-3">
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-white/15">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon_path %>" />
              </svg>
            </div>
            <span class="text-sm text-violet-100"><%= feat %></span>
          </div>
        <% end %>
      </div>
    </div>

    <p class="text-xs text-violet-400">© 2025 igle·org — Plataforma multi-tenant para iglesias</p>
  </div>

  <%# ── Right panel: form ── %>
  <div class="flex flex-1 flex-col items-center justify-center bg-slate-50 px-6 py-12">
    <div class="w-full max-w-sm">

      <%# Mobile logo %>
      <div class="mb-8 flex items-center gap-2 lg:hidden">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-violet-600 text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12 11.204 3.045c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <span class="text-lg font-bold tracking-tight text-slate-900">igle<span class="text-violet-600">·org</span></span>
      </div>

      <h1 class="text-2xl font-bold text-slate-900">Bienvenido de nuevo</h1>
      <p class="mt-1.5 text-sm text-slate-500">Ingresa tus credenciales para acceder a tu cuenta.</p>

      <%= form_for(
            resource,
            as: resource_name,
            url: user_session_path,
            html: {
              class: "mt-8 space-y-5",
              data: { turbo: false }
            }
          ) do |form| %>

        <div>
          <%= form.label :email, "Correo electrónico",
                class: "block text-sm font-medium text-slate-700" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email",
                placeholder: "tu@email.com",
                class: "mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 shadow-sm transition-colors focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>

        <div>
          <%= form.label :password, "Contraseña",
                class: "block text-sm font-medium text-slate-700" %>
          <%= form.password_field :password, autocomplete: "current-password",
                placeholder: "••••••••",
                class: "mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 shadow-sm transition-colors focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" %>
        </div>

        <div class="flex items-center justify-between">
          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-2 text-sm text-slate-600 cursor-pointer">
              <%= form.check_box :remember_me,
                    class: "h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-500 cursor-pointer" %>
              Recordarme
            </label>
          <% end %>
          <%= link_to "¿Olvidaste tu contraseña?", new_user_password_path,
                class: "text-sm font-medium text-violet-600 hover:text-violet-700 transition-colors" %>
        </div>

        <%= form.submit "Iniciar sesión",
              class: "mt-2 w-full cursor-pointer rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2" %>
      <% end %>

    </div>
  </div>

</div>
