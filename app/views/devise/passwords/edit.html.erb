<section class="mx-auto flex min-h-[70vh] w-full max-w-md flex-col justify-center px-6 py-12">
  <div>
    <p class="text-sm font-semibold uppercase text-slate-500">Igle Org</p>
    <h1 class="mt-3 text-3xl font-semibold text-slate-950">Cambiar password</h1>
  </div>

  <%= form_for(
        resource,
        as: resource_name,
        url: user_password_path,
        html: {
          method: :put,
          class: "mt-8 rounded-lg border border-slate-200 bg-white p-6",
          data: { turbo: false }
        }
      ) do |form| %>
    <% if resource.errors.any? %>
      <div class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <ul class="list-disc pl-5">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :reset_password_token %>

    <div>
      <%= form.label :password, "Nuevo password", class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password, autofocus: true, autocomplete: "new-password", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <div class="mt-5">
      <%= form.label :password_confirmation, "Confirmar password", class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <%= form.submit "Cambiar password", class: "mt-6 w-full rounded-md bg-slate-950 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
  <% end %>
</section>
